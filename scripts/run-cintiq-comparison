#!/usr/bin/env python3
"""Freeze or serially execute the declared Cintiq matrix. No automatic retries."""
import argparse, datetime, hashlib, json, os, random, runpy, signal, subprocess, time
from pathlib import Path
A=runpy.run_path(str(Path(__file__).with_name('analyze-cintiq-comparison')))
def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def matrix(seed, display):
    rows=[('empty','short','warm'),('dense1000','long','warm'),('dense5000','short','warm'),('alpha','short','warm'),('clip','short','warm'),('image','short','warm'),('dense1000','panzoom','warm'),('empty','short','first-use'),('dense1000','short','after-idle')]
    pairs=[]
    for row,(scene,trace,state) in enumerate(rows):
        for policy in ('R','C'):
            for width,height in ((1600,1000),(2560,1600)):
                cell=f'primary-{row}-{policy}-{width}x{height}'
                for n in range(5): pairs.append((cell,n,scene,trace,state,policy,width,height,30))
    for width,height in ((1600,1000),(2560,1600)):
        for n in range(3): pairs.append((f'sustained-C-{width}x{height}',n,'dense1000','long','warm','C',width,height,180))
    random.Random(seed).shuffle(pairs); runs=[]
    for order,(cell,n,scene,trace,state,policy,width,height,duration) in enumerate(pairs):
        backends=('skia','coregraphics') if (n+int(hashlib.sha256(cell.encode()).hexdigest()[:8],16))%2==0 else ('coregraphics','skia')
        for backend in backends:
            pair_id=f'{cell}-pair{n}'
            runs.append(dict(id=pair_id+'-'+backend,pair_id=pair_id,cell=cell,pair=n,backend=backend,scene=scene,trace=trace,start_state=state,policy=policy,width=width,height=height,duration_s=duration,warmup_s=0 if state=='first-use' else 5,idle_s=30 if state=='after-idle' else 0,screen_id=display))
    return runs

def validate_build(build, revision, dirty):
    if dirty: raise ValueError('freeze requires clean source checkout')
    if build.get('source_revision')!=revision or build.get('source_status'): raise ValueError('build must identify this clean source revision')
    if build.get('rust_build_skipped') is True: raise ValueError('freeze rejects skipped Rust builds; rebuild the archive from this source')

def main():
    p=argparse.ArgumentParser(description=__doc__); p.add_argument('action',choices=('freeze','run')); p.add_argument('collection',type=Path); p.add_argument('--binary',type=Path,required=True); p.add_argument('--build-json',type=Path,required=True); p.add_argument('--screen-id',type=int,default=3); p.add_argument('--seed',type=int,default=20261014); p.add_argument('--source',type=Path,default=Path(__file__).resolve().parent.parent); p.add_argument('--limit',type=int); p.add_argument('--timeout-grace',type=float,default=180); a=p.parse_args()
    root=a.collection.resolve(); binary=a.binary.resolve(); build=json.loads(a.build_json.read_text()); identity=dict(binary_sha256=sha(binary),build=build)
    if a.action=='freeze':
        if root.exists(): p.error('collection must not exist; frozen collections cannot be overwritten')
        revision=subprocess.check_output(['git','rev-parse','HEAD'],cwd=a.source,text=True).strip()
        dirty=subprocess.check_output(['git','status','--porcelain'],cwd=a.source,text=True)
        try: validate_build(build,revision,dirty)
        except ValueError as error: p.error(str(error))
        root.mkdir(parents=True); (root/'runs').mkdir()
        m=dict(schema_version=1,created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),source_revision=revision,identity=identity,seed=a.seed,binary=str(binary),runs=matrix(a.seed,a.screen_id),scope='Synthetic 240Hz software only; physical latency pending camera')
        (root/'collection.json').write_text(json.dumps(m,indent=2)+'\n'); (root/'collection.sha256').write_text(sha(root/'collection.json')+'\n')
        print(f'Frozen {len(m["runs"])} runs. No app launched.'); return
    m=json.loads((root/'collection.json').read_text())
    if sha(root/'collection.json')!=(root/'collection.sha256').read_text().strip() or m['identity']!=identity: p.error('frozen manifest or binary/build identity mismatch')
    if (root/'HALTED.json').exists(): p.error('collection previously halted; preserve it. Diagnose and freeze a new collection; no automatic retry.')
    def log(kind,**fields):
        record=dict(time_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),kind=kind,**fields)
        with (root/'progress.jsonl').open('a') as f: f.write(json.dumps(record)+'\n')
        print(json.dumps(record),flush=True)
    def halt(reason,run):
        (root/'HALTED.json').write_text(json.dumps(dict(reason=reason,run=run),indent=2)+'\n'); log('halted',reason=reason,run=run); raise SystemExit(1)
    count=0
    for c in m['runs']:
        folder=root/'runs'/c['id']
        if folder.exists():
            try:
                A['analyze_run'](folder,c,identity)
                hashes=json.loads((folder/'collection-receipt.json').read_text())
                required={'manifest.json','frames.json','deliveries.json','metal-observations.json','final.png'}
                if set(hashes)!=required or hashes!={name:sha(folder/name) for name in hashes}: raise ValueError('completed output changed or receipt incomplete')
            except Exception as e: halt('existing output cannot safely resume: '+str(e),c['id'])
            log('resume-skip-complete',run=c['id']); continue
        if a.limit is not None and count>=a.limit: log('paused-at-requested-limit',completed_this_invocation=count); return
        if sha(binary)!=identity['binary_sha256']: halt('binary changed during collection',c['id'])
        cmd=[str(binary),'--output',str(folder),'--instrumentation','full']
        for key,flag in [('backend','backend'),('policy','policy'),('scene','scene'),('trace','trace'),('start_state','start-state'),('width','width'),('height','height'),('screen_id','screen-id'),('duration_s','duration-seconds'),('warmup_s','warmup-seconds'),('idle_s','idle-seconds')]: cmd += ['--'+flag,str(c[key])]
        log('start',run=c['id'],command=cmd); started=time.monotonic(); proc=None
        try:
            with (root/(c['id']+'.log')).open('xb') as output:
                proc=subprocess.Popen(cmd,stdout=output,stderr=subprocess.STDOUT)
                proc.wait(timeout=c['duration_s']+c['warmup_s']+c['idle_s']+a.timeout_grace)
            if proc.returncode: halt('native process exit '+str(proc.returncode),c['id'])
            A['analyze_run'](folder,c,identity)
            files=['manifest.json','frames.json','deliveries.json','metal-observations.json','final.png']
            (folder/'collection-receipt.json').write_text(json.dumps({name:sha(folder/name) for name in files},indent=2)+'\n')
        except (KeyboardInterrupt,subprocess.TimeoutExpired) as e:
            if proc and proc.poll() is None:
                proc.send_signal(signal.SIGTERM)
                try: proc.wait(timeout=10)
                except subprocess.TimeoutExpired: proc.kill(); proc.wait()
            halt(type(e).__name__+'; output preserved, not retried',c['id'])
        except (ValueError,KeyError,OSError,TypeError) as e: halt(str(e),c['id'])
        count+=1; log('complete',run=c['id'],elapsed_s=time.monotonic()-started)
    log('collection-complete')
if __name__=='__main__': main()
