#!/usr/bin/env python3
"""Extract secondary first-sample draw-start evidence from validated Cintiq artifacts."""
import argparse
import json
import math
import runpy
from pathlib import Path

A = runpy.run_path(str(Path(__file__).with_name('analyze-cintiq-comparison')))
RECEIPT_FILES = {'manifest.json', 'frames.json', 'deliveries.json', 'metal-observations.json', 'final.png'}


def extract(analysis_path, collection_path):
    analysis_path, root = Path(analysis_path), Path(collection_path)
    analysis = A['read'](analysis_path)
    collection = A['read'](root / 'collection.json')
    collection_sha = A['digest'](root / 'collection.json')
    A['require'](collection_sha == (root / 'collection.sha256').read_text().strip(), 'frozen collection checksum mismatch')
    A['require'](analysis['collection_identity'] == collection['identity'], 'analysis/native collection identity mismatch')
    configs = {c['id']: c for c in collection['runs']}
    A['require'](len(configs) == len(collection['runs']), 'duplicate declared run ID')
    A['require'](analysis['accepted_runs'] == len(analysis['runs']), 'analysis accepted count mismatch')
    rows = []
    for run_id, recorded in analysis['runs'].items():
        A['require'](run_id in configs and recorded['config'] == configs[run_id], 'analysis run/config not declared by frozen collection')
        config = configs[run_id]
        if config['start_state'] not in ('first-use', 'after-idle'):
            continue
        A['require'](Path(run_id).name == run_id and run_id not in ('.', '..'), 'invalid run path')
        folder = root / 'runs' / run_id
        # analyze_run accepts an absent receipt for exploratory checking; this extractor
        # deliberately requires a collector-accepted immutable artifact receipt.
        receipt = A['read'](folder / 'collection-receipt.json')
        A['require'](set(receipt) == RECEIPT_FILES, 'accepted receipt missing artifact identities')
        A['require'](all(A['digest'](folder / name) == sha for name, sha in receipt.items()), 'accepted artifact checksum mismatch')
        checked = A['analyze_run'](folder, config, collection['identity'])
        A['require'](checked == recorded, 'validated analysis differs from accepted raw run')
        manifest = A['read'](folder / 'manifest.json')
        samples = manifest['final']['replay']['trace_samples']
        sample = samples[0]
        batches = [batch for batch in A['read'](folder / 'deliveries.json') if batch['first_sample_id'] <= sample['id'] <= batch['last_sample_id']]
        A['require'](len(batches) == 1, 'first sample lacks unique receipt')
        batch = batches[0]
        # total_samples excludes empty initial draws, including a sample-ID-zero sentinel.
        frames = [frame for frame in A['read'](folder / 'frames.json') if frame['total_samples'] >= 1]
        A['require'](bool(frames), 'first sample was never drawn')
        frame = frames[0]
        scheduled = batch['epoch_s'] + sample['time_s']
        times = {
            'scheduled_to_receipt_ms': (batch['receipt_s'] - scheduled) * 1000,
            'receipt_to_draw_start_ms': (frame['draw_start_s'] - batch['receipt_s']) * 1000,
            'scheduled_to_draw_start_ms': (frame['draw_start_s'] - scheduled) * 1000,
            'first_frame_draw_wall_ms': frame['draw_cpu_ms'],
            'first_frame_cache_build_ms': frame['cache_build_ms'],
            'host_launch_to_first_measured_draw_start_ms': frame['host_launch_to_draw_ms'],
        }
        A['require'](all(isinstance(value, (int, float)) and math.isfinite(value) and value >= -0.001 for value in times.values()), 'invalid first-mark timing')
        A['require'](isinstance(manifest['initialization'], list), 'initialization stages missing')
        rows.append(dict(run_id=run_id, cell=config['cell'], backend=config['backend'], start_state=config['start_state'], first_sample_id=sample['id'], **times, initialization_stages=manifest['initialization']))
    return {
        'schema_version': 1,
        'analysis_sha256': A['digest'](analysis_path),
        'collection_sha256': collection_sha,
        'native_identity': collection['identity'],
        'rows': rows,
        'scope': 'Secondary evidence only: scheduled first expected sample to its receipt and first representing draw start. Not callback completion, visible ink, or physical pen-to-screen latency; camera pending. Generated replay bypasses the Wacom digitizer and driver. No primary metric, threshold, or backend selection is changed.',
        'aggregation_warning': 'A whole 30-second run p95 can dilute a one-time first-mark cost. These rows identify the first expected sample, not the latest sample represented by the first frame.',
        'host_launch_scope': 'Host-launch-to-first-measured-draw includes process initialization and replay/reference construction. For after-idle runs it also includes warm-up, reset, cache preparation and idle waiting; it is not first-mark latency. Initialization stages are reported separately as recorded.',
        'draw_wall_scope': 'First-frame synchronous callback wall duration includes the backend-specific draw path and possible drawable acquisition. Core Graphics can rasterize after callback return; process CPU and optical endpoints have different scopes.',
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('analysis', type=Path)
    parser.add_argument('collection', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    args = parser.parse_args()
    output, root = args.output.resolve(), args.collection.resolve()
    if output == args.analysis.resolve() or output == root or root in output.parents:
        parser.error('output must be outside the read-only collection and must not overwrite analysis')
    try:
        result = extract(args.analysis, root)
    except (KeyError, ValueError, TypeError, OSError) as error:
        parser.exit(1, str(error) + '\n')
    output.write_text(json.dumps(result, indent=2) + '\n')
    print(f"{len(result['rows'])} accepted first-use/after-idle rows; physical latency pending")


if __name__ == '__main__':
    main()
