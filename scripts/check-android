#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
: "${ANDROID_HOME:=$HOME/Library/Android/sdk}"
: "${ANDROID_SERIAL:?Set ANDROID_SERIAL explicitly to the dedicated Native Sketch test device before running this installation and replay}"
export ANDROID_SERIAL
adb="$ANDROID_HOME/platform-tools/adb"
"$adb" install -r "$repo_root/artifacts/NativeSketch-android.apk"
"$adb" logcat -c
launch_output="$("$adb" shell am start -S -W -n dev.nativesketch/.MainActivity --ez replay true)"
printf '%s\n' "$launch_output"
if [[ "$launch_output" != *"Status: ok"* || "$launch_output" == *"Error:"* || "$launch_output" == *"Activity not started"* ]]; then
    echo "Replay activity did not start cleanly" >&2
    exit 1
fi
for attempt in {1..30}; do
    output="$("$adb" logcat -d -s NativeSketchReplay:I AndroidRuntime:E)"
    if [[ "$output" == *"FAIL: Android replay"* ]]; then printf '%s\n' "$output"; exit 1; fi
    if [[ "$output" == *"PASS: JNI"* ]]; then printf '%s\n' "$output"; exit 0; fi
    sleep 1
done
printf '%s\n' "$output"
exit 1
