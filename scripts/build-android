#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
: "${ANDROID_HOME:=$HOME/Library/Android/sdk}"
: "${ANDROID_NDK_HOME:=/private/tmp/native-sketch-sdk/android-ndk-r30}"
: "${JAVA_HOME:=/Applications/Android Studio.app/Contents/jbr/Contents/Home}"
: "${GRADLE:=gradle}"
export ANDROID_HOME JAVA_HOME
ndk_bin="$ANDROID_NDK_HOME/toolchains/llvm/prebuilt/darwin-x86_64/bin"
export CARGO_TARGET_AARCH64_LINUX_ANDROID_LINKER="$ndk_bin/aarch64-linux-android26-clang"
cargo build --locked -p sketch-ffi --release --target aarch64-linux-android
libs="$repo_root/apps/android/app/src/main/jniLibs/arm64-v8a"
mkdir -p "$libs" "$repo_root/artifacts"
cp target/aarch64-linux-android/release/libsketch_ffi.so "$libs/"
"$ndk_bin/aarch64-linux-android26-clang++" -std=c++17 -shared -fPIC -static-libstdc++ -Icrates/sketch-ffi/include apps/android/app/src/main/cpp/bridge.cpp -L"$libs" -lsketch_ffi -o "$libs/libsketch_jni.so"
"$GRADLE" -p apps/android --no-daemon assembleDebug
cp apps/android/app/build/outputs/apk/debug/app-debug.apk artifacts/NativeSketch-android.apk
