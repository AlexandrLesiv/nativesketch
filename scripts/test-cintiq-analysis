#!/usr/bin/env python3
"""Portable corruption, completeness, sample-zero and pairing regression checks."""
import copy, hashlib, json, runpy, tempfile, unittest, subprocess, sys
from pathlib import Path
HERE=Path(__file__).resolve().parent; A=runpy.run_path(str(HERE/'analyze-cintiq-comparison')); R=runpy.run_path(str(HERE/'run-cintiq-comparison'))
class AnalysisTests(unittest.TestCase):
    def setUp(self):
        # Disposable fixtures stay within ignored project artifacts.
        base=HERE.parent/'artifacts'; base.mkdir(exist_ok=True)
        self.temp=tempfile.TemporaryDirectory(prefix='cintiq-analysis-test-',dir=base); self.root=Path(self.temp.name)
        self.c=R['matrix'](1,3)[0]; self.identity={'binary_sha256':'binary','build':{'source_revision':'revision'}}
    def tearDown(self): self.temp.cleanup()
    def write(self,p,v): p.parent.mkdir(parents=True,exist_ok=True); p.write_text(json.dumps(v))
    def fixture(self,c=None,start_id=0):
        c=c or self.c; folder=self.root/'runs'/c['id']; folder.mkdir(parents=True)
        samples=[{'id':i+start_id,'time_s':i*.01} for i in range(3)]
        f={'elapsed_s':c['duration_s'],'expected_samples':3,'total_samples':3,'geometry_hash':'geo','document_hash':'doc','capture_sha256':hashlib.sha256(b'image').hexdigest(),'capture_kind':'proxy','advance_totals':{'calls':17,'whole_call_ms':2},'replay':{'source_revision':'revision','config':dict({k:c[k] for k in ('scene','trace','width','height','duration_s')},sample_hz=240),'trace_samples':samples,'expected_samples':3,'expected_final_geometry_hash':'geo','expected_final_document_hash':'doc','trace_sha256':'trace','image_sha256':'image','initial_document_revision':1}}
        m={k:c[k] for k in ('backend','policy','scene','trace','start_state','duration_s','warmup_s','idle_s')}; m.update(status='complete',initial={'selected_screen_id':c['screen_id'],'actual_screen_id':c['screen_id'],'screens':[{'id':c['screen_id'],'in_mirror_set':False,'mirrors_display':0,'pixel_width':3840,'pixel_height':2160}],'physical_width':c['width'],'physical_height':c['height']},logging_enabled=True,self_test=False,final=f,occlusion_checks=5,occlusion_query_unavailable=0,**self.identity)
        self.write(folder/'manifest.json',m); (folder/'final.png').write_bytes(b'image')
        self.write(folder/'deliveries.json',[dict(receipt_s=1.025,epoch_s=1,first_sample_id=start_id,last_sample_id=start_id+2,sample_count=3)])
        # Empty frame must not claim sample zero; next frame catches all three.
        rows=[dict(frame=0,draw_start_s=1.0,epoch_s=1,total_samples=0,sample_id=0),dict(frame=1,draw_start_s=1.03,epoch_s=1,total_samples=3,sample_id=start_id+2)]
        self.write(folder/'frames.json',rows); self.write(folder/'metal-observations.json',[]); return folder
    def test_first_draw_math_and_zero(self):
        for start in (0,1):
            c=dict(self.c,id=self.c['id']+str(start)); r=A['analyze_run'](self.fixture(c,start),c,self.identity)
            self.assertAlmostEqual(r['metrics']['scheduled_to_receipt_ms']['p50'],15)
            self.assertAlmostEqual(r['metrics']['receipt_to_first_draw_ms']['p95'],5)
            self.assertAlmostEqual(r['metrics']['scheduled_to_first_draw_ms']['p95'],29)
            self.assertEqual(r['advance_totals']['calls'],17)
    def mutate_reject(self,file,change):
        folder=self.fixture(); data=json.loads((folder/file).read_text()); change(data); self.write(folder/file,data)
        with self.assertRaises(ValueError): A['analyze_run'](folder,self.c,self.identity)
    def test_delivery_gap(self): self.mutate_reject('deliveries.json',lambda x:x[0].update(first_sample_id=1,sample_count=2))
    def test_duplicate_delivery(self): self.mutate_reject('deliveries.json',lambda x:x.append(dict(x[0])))
    def test_missing_last_draw(self): self.mutate_reject('frames.json',lambda x:x.pop())
    def test_hash_corruption(self): self.mutate_reject('manifest.json',lambda x:x['final'].update(document_hash='bad'))
    def test_binary_corruption(self): self.mutate_reject('manifest.json',lambda x:x.update(binary_sha256='other'))
    def test_stale_rust_archive(self): self.mutate_reject('manifest.json',lambda x:x['final']['replay'].update(source_revision='stale'))
    def test_early_completion(self): self.mutate_reject('manifest.json',lambda x:x['final'].update(elapsed_s=x['duration_s']-.01))
    def test_selected_display_mismatch(self): self.mutate_reject('manifest.json',lambda x:x['initial'].update(selected_screen_id=2))
    def test_actual_display_mismatch(self): self.mutate_reject('manifest.json',lambda x:x['initial'].update(actual_screen_id=2))
    def test_mirrored_display(self): self.mutate_reject('manifest.json',lambda x:x['initial']['screens'][0].update(in_mirror_set=True))
    def test_mirror_source(self): self.mutate_reject('manifest.json',lambda x:x['initial']['screens'][0].update(mirrors_display=2))
    def test_display_too_small(self): self.mutate_reject('manifest.json',lambda x:x['initial']['screens'][0].update(pixel_width=800))
    def test_display_missing(self): self.mutate_reject('manifest.json',lambda x:x['initial'].update(screens=[]))
    def test_skipped_rust_build(self):
        with self.assertRaisesRegex(ValueError,'skipped Rust'): R['validate_build']({'source_revision':'revision','source_status':'','rust_build_skipped':True},'revision','')
        R['validate_build']({'source_revision':'revision','source_status':'','rust_build_skipped':False},'revision','')
    def test_capture_corruption(self):
        folder=self.fixture(); (folder/'final.png').write_bytes(b'bad')
        with self.assertRaises(ValueError): A['analyze_run'](folder,self.c,self.identity)
    def collection(self,configs):
        self.write(self.root/'collection.json',dict(runs=configs,identity=self.identity,recovery_s=2)); (self.root/'collection.sha256').write_text(A['digest'](self.root/'collection.json'))
    def test_partial_matrix(self):
        configs=R['matrix'](1,3); self.collection(configs); self.fixture(configs[0]); r=A['analyze'](self.root)
        self.assertEqual(r['declared_runs'],372); self.assertEqual(len(r['pending']),371); self.assertEqual(r['status'],'partial'); self.assertEqual(r['pairs'],[])
    def test_pair_identity_rejection(self):
        configs=R['matrix'](1,3)[:2]; self.collection(configs); self.fixture(configs[0]); folder=self.fixture(configs[1]); m=json.loads((folder/'manifest.json').read_text()); m['final']['replay']['trace_sha256']='different'; self.write(folder/'manifest.json',m)
        with self.assertRaisesRegex(ValueError,'pair input'): A['analyze'](self.root)
    def test_pair_thermal_change_is_reported(self):
        configs=R['matrix'](1,3)[:2]; self.collection(configs)
        for index,c in enumerate(configs):
            folder=self.fixture(c); m=json.loads((folder/'manifest.json').read_text()); m['initial']['thermal_state']=index; m['initial']['low_power_mode']=False; m['final']['low_power_mode']=False; self.write(folder/'manifest.json',m)
        r=A['analyze'](self.root); self.assertEqual(len(r['pairs']),1)
        self.assertEqual({v['resource_observations']['initial']['thermal_state'] for v in r['runs'].values()},{0,1})
    def test_pair_power_change_rejected(self):
        configs=R['matrix'](1,3)[:2]; self.collection(configs)
        for index,c in enumerate(configs):
            folder=self.fixture(c); m=json.loads((folder/'manifest.json').read_text()); m['initial']['low_power_mode']=bool(index); m['final']['low_power_mode']=bool(index); self.write(folder/'manifest.json',m)
        with self.assertRaisesRegex(ValueError,'power mode'): A['analyze'](self.root)
    def test_pair_math(self):
        configs=R['matrix'](1,3)[:2]; self.collection(configs)
        for c in configs:self.fixture(c)
        r=A['analyze'](self.root); self.assertEqual(r['pairs'][0]['delta_p95_cg_minus_skia_ms'],0); self.assertEqual(r['cells'][0]['exploratory_pair_bootstrap_95'],[0,0])
    def test_manifest_corruption(self):
        self.collection([]); (self.root/'collection.json').write_text('{}')
        with self.assertRaisesRegex(ValueError,'modified'): A['analyze'](self.root)
    def test_runner_halts_incomplete_without_launch(self):
        configs=R['matrix'](1,3); binary=Path('/usr/bin/false')
        self.identity={'binary_sha256':A['digest'](binary),'build':{}}
        self.collection(configs); build=self.root/'build.json'; self.write(build,{})
        (self.root/'runs'/configs[0]['id']).mkdir(parents=True)
        command=[sys.executable,str(HERE/'run-cintiq-comparison'),'run',str(self.root),'--binary',str(binary),'--build-json',str(build)]
        first=subprocess.run(command,capture_output=True,text=True)
        self.assertNotEqual(first.returncode,0); self.assertTrue((self.root/'HALTED.json').exists())
        second=subprocess.run(command,capture_output=True,text=True)
        self.assertNotEqual(second.returncode,0); self.assertIn('previously halted',second.stderr)
    def test_runner_exit_failure_halts(self):
        configs=R['matrix'](1,3); binary=Path('/usr/bin/false')
        self.identity={'binary_sha256':A['digest'](binary),'build':{}}
        self.collection(configs); build=self.root/'build.json'; self.write(build,{})
        result=subprocess.run([sys.executable,str(HERE/'run-cintiq-comparison'),'run',str(self.root),'--binary',str(binary),'--build-json',str(build)],capture_output=True,text=True)
        self.assertNotEqual(result.returncode,0)
        self.assertIn('process exit',json.loads((self.root/'HALTED.json').read_text())['reason'])
    def test_cpu_fields_preserved_without_relabeling(self):
        folder=self.fixture(); m=json.loads((folder/'manifest.json').read_text())
        cpu={'measured_cpu_user_s':1.25,'measured_cpu_system_s':.5,'measured_cpu_scope':'Process measured CPU; not GPU or WindowServer CPU','draw_cpu_total_ms':1700,'draw_cpu_max_ms':44,'draw_cpu_count':23,'draw_cpu_scope':'Callback wall duration, not CPU utilization'}
        m['final'].update(cpu); self.write(folder/'manifest.json',m)
        result=A['analyze_run'](folder,self.c,self.identity)
        for key,value in cpu.items(): self.assertEqual(result['resource_observations']['final'][key],value)
        self.assertIn('wall durations',result['resource_scope'])
    def test_missing_cpu_is_unknown(self):
        result=A['analyze_run'](self.fixture(),self.c,self.identity)
        self.assertIsNone(result['resource_observations']['final']['measured_cpu_user_s'])
        self.assertIsNone(result['resource_observations']['final']['measured_cpu_system_s'])
    def test_report_cpu_labels_and_responsive_text(self):
        configs=R['matrix'](1,3)[:2]; self.collection(configs)
        for c in configs:
            folder=self.fixture(c); m=json.loads((folder/'manifest.json').read_text()); m['final'].update(measured_cpu_user_s=1.25,measured_cpu_system_s=None,draw_cpu_total_ms=345.6,draw_cpu_max_ms=12.34,draw_cpu_count=7); self.write(folder/'manifest.json',m)
        analysis=self.root/'analysis.json'; self.write(analysis,A['analyze'](self.root)); output=self.root/'report.html'
        subprocess.run([sys.executable,str(HERE/'build-cintiq-report'),str(analysis),'--output',str(output)],check=True,capture_output=True)
        report=output.read_text()
        for text in ('Measured process CPU and callback wall time','External WindowServer CPU and GPU execution are not included','<td>1.25</td><td>—</td><td>345.60</td>','white-space:pre-wrap','overflow-wrap:anywhere',configs[0]['cell'],str(configs[0]['width'])+'×'+str(configs[0]['height'])+' px'):
            self.assertIn(text,report)
        self.assertIn('Cached base + live ink (C)' if configs[0]['policy']=='C' else 'Full redraw (R)',report)
    def failure_fixture(self,backend='coregraphics'):
        c=next(c for c in R['matrix'](1,3) if c['duration_s']==180 and c['backend']==backend)
        folder=self.fixture(c,1); m=json.loads((folder/'manifest.json').read_text()); m.update(status='failed',reason=A['TERMINAL_REASON'],lifecycle=[],metal_observation_count=0)
        f=m['final']; f.update(elapsed_s=190,expected_samples=43201,total_samples=43201,measured_frames=1,gpu_retirement_status=4)
        f['replay'].update(expected_samples=43201,trace_samples=[{'id':i+1,'time_s':i/240} for i in range(43201)])
        f.pop('capture_sha256'); f.pop('capture_kind'); (folder/'final.png').unlink(); self.write(folder/'manifest.json',m)
        self.write(folder/'frames.json',[dict(frame=0,draw_start_s=1.2,epoch_s=1,total_samples=25,sample_id=25,geometry_hash='earlier')])
        self.write(folder/'deliveries.json',[dict(receipt_s=1.1,epoch_s=1,first_sample_id=1,last_sample_id=25,sample_count=25),dict(receipt_s=181,epoch_s=1,first_sample_id=26,last_sample_id=43201,sample_count=43176)])
        self.write(folder/'native-input.json',[]); (folder/'frames.csv').write_text('frame\n0\n'); return folder,c
    def failure_reject(self,mutate):
        folder,c=self.failure_fixture(); m=json.loads((folder/'manifest.json').read_text()); mutate(m); self.write(folder/'manifest.json',m)
        with self.assertRaises(ValueError): A['analyze_failure'](folder,c,self.identity)
    def test_terminal_failure_is_not_accepted_timing(self):
        folder,c=self.failure_fixture(); observation=A['analyze_failure'](folder,c,self.identity)
        self.assertEqual(observation['samples_never_drawn'],43176); self.assertNotIn('metrics',observation)
        with self.assertRaises(ValueError): A['analyze_run'](folder,c,self.identity)
        R['record_failed_receipt'](folder); A['verify_failure_receipt'](folder)
        configs=[x for x in R['matrix'](1,3) if x['pair_id']==c['pair_id']]; self.collection(configs)
        manifest=json.loads((self.root/'collection.json').read_text()); manifest['failure_policy']=A['FAILURE_POLICY']; self.write(self.root/'collection.json',manifest); (self.root/'collection.sha256').write_text(A['digest'](self.root/'collection.json'))
        result=A['analyze'](self.root); self.assertEqual(result['attempted_runs'],1); self.assertEqual(result['failed_runs'],1); self.assertEqual(result['accepted_runs'],0); self.assertEqual(result['pairs'],[])
        analysis=self.root/'failed-analysis.json'; self.write(analysis,result); output=self.root/'failed-report.html'
        subprocess.run([sys.executable,str(HERE/'build-cintiq-report'),str(analysis),'--output',str(output)],check=True,capture_output=True)
        report=output.read_text(); self.assertIn('90 times with abrupt position resets',report); self.assertIn('1 classified failed observations',report); self.assertIn('43176',report); self.assertIn('no accepted timing distribution',report)
    def test_failure_stop_rejected(self): self.failure_reject(lambda m:m.update(status='cancelled'))
    def test_failure_other_reason_rejected(self): self.failure_reject(lambda m:m.update(reason='GPU retirement fence timeout'))
    def test_failure_visibility_event_rejected(self): self.failure_reject(lambda m:m.update(lifecycle=[{'reason':'occluded'}]))
    def test_failure_early_watchdog_rejected(self): self.failure_reject(lambda m:m['final'].update(elapsed_s=189))
    def test_failure_wrong_final_hash_rejected(self): self.failure_reject(lambda m:m['final'].update(geometry_hash='wrong'))
    def test_failure_native_input_rejected(self):
        folder,c=self.failure_fixture(); self.write(folder/'native-input.json',[{'type':'down'}])
        with self.assertRaises(ValueError): A['analyze_failure'](folder,c,self.identity)
    def test_failure_receipt_corruption_rejected(self):
        folder,c=self.failure_fixture(); R['record_failed_receipt'](folder); self.write(folder/'native-input.json',[{}])
        with self.assertRaises(ValueError): A['verify_failure_receipt'](folder)
    def test_failure_incomplete_files_rejected(self):
        folder,c=self.failure_fixture(); (folder/'native-input.json').unlink()
        with self.assertRaises(ValueError): A['analyze_failure'](folder,c,self.identity)
    def test_failure_wrong_cell_rejected(self):
        folder,c=self.failure_fixture(); c=dict(c,cell='primary-0-C-1600x1000')
        with self.assertRaises(ValueError): A['analyze_failure'](folder,c,self.identity)
    def test_failure_already_terminal_draw_rejected(self):
        folder,c=self.failure_fixture(); self.write(folder/'frames.json',[dict(frame=0,draw_start_s=181,epoch_s=1,total_samples=43201,sample_id=43201,geometry_hash='geo')])
        with self.assertRaisesRegex(ValueError,'already drawn'): A['analyze_failure'](folder,c,self.identity)
    def test_skia_failure_requires_retirement(self):
        folder,c=self.failure_fixture('skia'); A['analyze_failure'](folder,c,self.identity)
        m=json.loads((folder/'manifest.json').read_text()); m['final']['gpu_retirement_status']=5; self.write(folder/'manifest.json',m)
        with self.assertRaisesRegex(ValueError,'retirement'): A['analyze_failure'](folder,c,self.identity)
    def test_failed_receipt_resume_does_not_launch(self):
        binary=Path('/usr/bin/false'); self.identity={'binary_sha256':A['digest'](binary),'build':{'source_revision':'revision'}}
        folder,c=self.failure_fixture(); R['record_failed_receipt'](folder)
        configs=[c]+[x for x in R['matrix'](1,3) if x['id']!=c['id']]; self.collection(configs)
        manifest=json.loads((self.root/'collection.json').read_text()); manifest['failure_policy']=A['FAILURE_POLICY']; self.write(self.root/'collection.json',manifest); (self.root/'collection.sha256').write_text(A['digest'](self.root/'collection.json'))
        build=self.root/'build.json'; self.write(build,self.identity['build'])
        command=[sys.executable,str(HERE/'run-cintiq-comparison'),'run',str(self.root),'--binary',str(binary),'--build-json',str(build),'--limit','0']
        result=subprocess.run(command,capture_output=True,text=True)
        self.assertEqual(result.returncode,0,result.stderr); self.assertIn('resume-skip-failed-observation',result.stdout); self.assertFalse((self.root/'HALTED.json').exists())
        (folder/'frames.csv').write_text('frame\n999\n')
        result=subprocess.run(command,capture_output=True,text=True); self.assertNotEqual(result.returncode,0); self.assertTrue((self.root/'HALTED.json').exists())
    def test_verified_native_revision_allows_only_collector_changes(self):
        repo=self.root/'repo'; repo.mkdir()
        def git(*args): return subprocess.check_output(['git','-c','user.name=Test','-c','user.email=test@example.invalid',*args],cwd=repo,text=True,stderr=subprocess.DEVNULL).strip()
        git('init'); (repo/'crates').mkdir(); (repo/'crates'/'native.rs').write_text('native v1'); git('add','.'); git('commit','-m','native'); native=git('rev-parse','HEAD')
        (repo/'collector').write_text('collector v2'); git('add','.'); git('commit','-m','collector'); collector=git('rev-parse','HEAD')
        self.assertEqual(R['native_revision'](repo,{'source_revision':native},collector,native),native)
        (repo/'crates'/'native.rs').write_text('native v2'); git('add','.'); git('commit','-m','native changed')
        with self.assertRaises(subprocess.CalledProcessError): R['native_revision'](repo,{'source_revision':native},git('rev-parse','HEAD'),native)
    def test_incomplete_attempt_is_not_unattempted_pending(self):
        configs=R['matrix'](1,3); self.collection(configs); (self.root/(configs[0]['id']+'.log')).write_text('launch attempted')
        result=A['analyze'](self.root)
        self.assertEqual(result['attempted_runs'],1); self.assertEqual(len(result['invalid']),1); self.assertEqual(len(result['pending']),371)
    def paired_failures(self,accept_skia=False,mutate_coregraphics=None):
        configs=[]
        for backend in ('skia','coregraphics'):
            folder,c=self.failure_fixture(backend); configs.append(c)
            m=json.loads((folder/'manifest.json').read_text())
            m['final'].update(measured_cpu_user_s=12.34,measured_cpu_system_s=.5)
            if backend=='coregraphics' and mutate_coregraphics: mutate_coregraphics(m)
            if backend=='skia' and accept_skia:
                m['status']='complete'; m['reason']=''; m['final']['capture_sha256']=hashlib.sha256(b'image').hexdigest(); m['final']['capture_kind']='proxy'; (folder/'final.png').write_bytes(b'image')
                rows=json.loads((folder/'frames.json').read_text()); rows.append(dict(frame=1,draw_start_s=181.1,epoch_s=1,total_samples=43201,sample_id=43201,geometry_hash='geo')); self.write(folder/'frames.json',rows)
            self.write(folder/'manifest.json',m)
            if m['status']=='failed': R['record_failed_receipt'](folder)
        self.assertEqual(configs[0]['pair_id'],configs[1]['pair_id'])
        self.collection(configs); manifest=json.loads((self.root/'collection.json').read_text()); manifest['failure_policy']=A['FAILURE_POLICY']; self.write(self.root/'collection.json',manifest); (self.root/'collection.sha256').write_text(A['digest'](self.root/'collection.json'))
        return configs
    def test_both_failed_pair_is_visible_without_delta(self):
        self.paired_failures(); result=A['analyze'](self.root)
        self.assertEqual(result['failed_runs'],2); self.assertEqual(result['pairs'],[])
        pair=result['pair_outcomes'][0]; self.assertTrue(pair['matched_identity_verified']); self.assertFalse(pair['numeric_delta_available'])
        self.assertEqual([pair['backends'][b]['outcome'] for b in ('skia','coregraphics')],['failed','failed'])
        self.assertEqual(result['failed'][0]['resource_observations']['final']['measured_cpu_user_s'],12.34)
        analysis=self.root/'both-failed.json'; self.write(analysis,result); output=self.root/'both-failed.html'
        subprocess.run([sys.executable,str(HERE/'build-cintiq-report'),str(analysis),'--output',str(output)],check=True,capture_output=True)
        report=output.read_text(); self.assertIn('<td>failed</td><td>failed</td>',report); self.assertIn('can miss transient occlusion',report)
    def test_mixed_pair_is_visible_without_delta(self):
        self.paired_failures(accept_skia=True); result=A['analyze'](self.root)
        self.assertEqual(result['accepted_runs'],1); self.assertEqual(result['failed_runs'],1); self.assertEqual(result['pairs'],[])
        pair=result['pair_outcomes'][0]; self.assertTrue(pair['matched_identity_verified']); self.assertFalse(pair['numeric_delta_available'])
        self.assertEqual([pair['backends'][b]['outcome'] for b in ('skia','coregraphics')],['accepted','failed'])
    def test_failed_pair_identity_mismatch_rejected(self):
        self.paired_failures(mutate_coregraphics=lambda m:m['final']['replay'].update(trace_sha256='different'))
        with self.assertRaisesRegex(ValueError,'pair input/display'): A['analyze'](self.root)
    def test_failed_pair_power_mismatch_rejected(self):
        def power(m): m['initial']['low_power_mode']=True; m['final']['low_power_mode']=True
        self.paired_failures(mutate_coregraphics=power)
        with self.assertRaisesRegex(ValueError,'power mode'): A['analyze'](self.root)
    def test_every_pending_pair_is_visible(self):
        self.collection(R['matrix'](1,3)); result=A['analyze'](self.root)
        self.assertEqual(len(result['pair_outcomes']),186)
        self.assertTrue(all(p['backends']['skia']['outcome']=='pending' and p['backends']['coregraphics']['outcome']=='pending' and not p['numeric_delta_available'] for p in result['pair_outcomes']))
    def test_invalid_pair_state_is_visible(self):
        configs=R['matrix'](1,3)[:2]; self.collection(configs); folder=self.fixture(configs[0]); m=json.loads((folder/'manifest.json').read_text()); m['binary_sha256']='other'; self.write(folder/'manifest.json',m)
        result=A['analyze'](self.root); pair=result['pair_outcomes'][0]
        self.assertEqual(pair['backends'][configs[0]['backend']]['outcome'],'invalid'); self.assertEqual(pair['backends'][configs[1]['backend']]['outcome'],'pending')
    def test_matrix(self):
        a=R['matrix'](1,3); self.assertEqual(a,R['matrix'](1,3)); self.assertNotEqual(a,R['matrix'](2,3)); self.assertEqual(len({c['id'] for c in a}),372)
        self.assertEqual(sum(c['duration_s'] for c in a),216*60)
        self.assertEqual(sum(c['duration_s']==180 for c in a),12)
if __name__=='__main__': unittest.main()
