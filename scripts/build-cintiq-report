#!/usr/bin/env python3
"""Standalone HTML/SVG report from validated software comparison JSON."""
import argparse, html, json
from pathlib import Path
p=argparse.ArgumentParser(description=__doc__); p.add_argument('analysis'); p.add_argument('--output',required=True); a=p.parse_args(); d=json.loads(Path(a.analysis).read_text()); e=lambda v:html.escape(str(v)); fmt=lambda v:f'{v:.2f}' if isinstance(v,(float,int)) else '—'
scene_names={'empty':'Empty canvas','dense1000':'1,000 committed strokes','dense5000':'5,000 committed strokes','alpha':'Translucency','clip':'Clipping','image':'Image'}
trace_names={'short':'Short strokes','long':'Repeated-overlap stress','panzoom':'Pan/zoom + overlap stress'}
state_names={'warm':'Warm','first-use':'First painter use','after-idle':'After idle'}
cell_configs={r['config']['cell']:r['config'] for r in list(d['runs'].values())+d.get('failed',[])}
def cell_lines(cell):
    c=cell_configs.get(cell)
    if not c: return [cell,'Configuration unavailable']
    return [scene_names.get(c['scene'],c['scene'])+' · '+trace_names.get(c['trace'],c['trace']),state_names.get(c['start_state'],c['start_state'])+' · '+('Full redraw (R)' if c['policy']=='R' else 'Cached base + live ink (C)')+' · '+str(c['width'])+'×'+str(c['height'])+' px']
def cell_html(cell): return '<br>'.join(e(v) for v in cell_lines(cell))+'<br><code class="muted">'+e(cell)+'</code>'
parts=['''<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cintiq: Skia and Core Graphics software comparison</title><style>body{font:17px/1.6 system-ui,sans-serif;color:#172336;background:#f4f6fa;margin:0}main{max-width:1150px;margin:auto;padding:32px 20px}h1,h2{line-height:1.2}section{background:white;padding:24px;margin:20px 0;border-radius:12px}.notice{border-left:6px solid #ad6812}table{border-collapse:collapse;width:100%;font-size:14px}td,th{overflow-wrap:anywhere;vertical-align:top;padding:10px;border-bottom:1px solid #ccd4df;text-align:left}.scroll{max-width:100%;overflow:auto}pre{white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}table{table-layout:fixed}section{min-width:0}@media(max-width:600px){main{padding:16px 10px}section{padding:16px}td,th{padding:7px;font-size:12px}}svg{max-width:100%;height:auto}.muted{color:#516074}a{color:#164b9c}code{overflow-wrap:anywhere}</style><main id="main"><h1>Skia / Metal and AppKit / Core Graphics on Cintiq</h1><p>Matched synthetic input, geometry, cache policy and physical canvas dimensions.</p><section class="notice"><h2>Physical pen-to-screen latency remains pending</h2><p>These results end at a software drawing callback. A suitable camera is required to observe physical pen movement and visible pixels. Generated 240 Hz replay bypasses Wacom digitizer and driver delivery. Neither backend is declared a physical-latency winner.</p></section>''']
parts.append(f'<section><h2>Coverage: {e(d["status"])}</h2><p>{d.get("attempted_runs",d["accepted_runs"]+len(d["invalid"]))} attempted of {d["declared_runs"]} declared runs; {d["accepted_runs"]} accepted; {d.get("failed_runs",0)} classified failed observations; {len(d["pending"])} pending; {len(d["invalid"])} invalid. Missing cells are not estimated. Acceptance here means software artifact validation; cross-backend image quality and native inspection are separate review gates.</p><p>Positive paired difference below means Skia reached the drawing callback sooner. Negative means Core Graphics did. This is software scheduling evidence, not visible ink.</p></section>')
parts.append('<section><h2>Outcomes for every declared pair</h2><p>Both candidates appear side by side, including pairs where both failed. Numeric timing differences exist only when both runs are accepted. Accepted/failed combinations are checked for matching input, canvas and power conditions before being presented as paired outcomes.</p><div class="scroll"><table><tr><th>Pair ID</th><th>Skia / Metal</th><th>Core Graphics</th><th>Matched identity checked</th><th>Numeric difference available</th></tr>')
for outcome in d.get('pair_outcomes',[]):
    parts.append('<tr><td>'+e(outcome['pair_id'])+'</td><td>'+e(outcome['backends']['skia']['outcome'])+'</td><td>'+e(outcome['backends']['coregraphics']['outcome'])+'</td><td>'+('Yes' if outcome['matched_identity_verified'] else 'Pending / unavailable')+'</td><td>'+('Yes' if outcome['numeric_delta_available'] else 'No')+'</td></tr>')
parts.append('</table></div></section>')
parts.append('<section class="notice"><h2>Adversarial sustained trace and failed outcomes</h2><p>Long traces and the ink portion of pan/zoom traces follow a repeated curve with abrupt end-to-start position resets. The 180-second sustained trace retraces the same path 90 times with abrupt position resets; a 30-second long trace makes 15 passes. These are repeated-overlap stress cases, not representative smooth motion or spatially growing lines. Short traces are separate 0.75-second strokes. A separately frozen, opt-in collector policy can continue after the exact terminal-paint watchdog only when input completeness, final expected hashes, source, configuration, display and lifecycle checks pass. The native watchdog is unchanged. Failed observations stay failed and contribute no accepted timing distribution or numeric paired difference. Stop, visibility changes and other failures still halt collection.</p>')
parts.append('<div class="scroll"><table><tr><th>Failed condition / backend</th><th>Never-drawn samples</th><th>Max observed draw gap ms</th><th>Latest / oldest undrawn age at finish ms</th><th>Process user / system CPU s</th><th>Exact reason</th></tr>')
for failure in d.get('failed',[]):
    c=failure['config']
    parts.append('<tr><td>'+cell_html(c['cell'])+'<br>'+e(c['backend'])+'<br><code>'+e(c['id'])+'</code></td><td>'+e(failure['samples_never_drawn'])+'</td><td>'+fmt(failure['maximum_observed_draw_gap_ms'])+'</td><td>'+fmt(failure['latest_undrawn_sample_age_at_finish_ms'])+' / '+fmt(failure['oldest_undrawn_sample_age_at_finish_ms'])+'</td><td>'+fmt(failure['process_cpu_user_s'])+' / '+fmt(failure['process_cpu_system_s'])+'</td><td>'+e(failure['reason'])+'</td></tr>')
parts.append('</table></div><p>Failure gaps include the censored interval from the last draw to finish entry. Undrawn sample ages are measured at that endpoint, not photons or observed first-draw latencies. Process CPU excludes external WindowServer and GPU execution. Successful-run distributions remain separate; do not treat them as an overall reliability ranking.</p><details><summary>Frozen collector and failure policy</summary><pre>'+e(json.dumps({'collector':d.get('collector'),'failure_policy':d.get('failure_policy','strict')},indent=2))+'</pre></details></section>')
parts.append('<section><h2>Paired p95 scheduled-to-first-draw difference</h2><p>Median of matched run differences: Core Graphics minus Skia, milliseconds. Intervals are exploratory 95% bootstrap intervals over pairs, not independent frames. Five pairs provide limited uncertainty evidence.</p>')
cells=d['cells']; bound=max([abs(v) for c in cells for v in c['exploratory_pair_bootstrap_95']]+[1]); height=max(120,75*len(cells)+40)
parts.append(f'<svg role="img" aria-label="Paired software timing differences; zero at center" viewBox="0 0 1080 {height}"><line x1="700" x2="700" y1="0" y2="{height-25}" stroke="#65748b"/>')
for i,c in enumerate(cells):
    y=25+i*75; lo,hi=c['exploratory_pair_bootstrap_95']; x=lambda v:700+300*v/bound
    parts.append(f'<text x="0" y="{y}" font-size="14">{e(cell_lines(c["cell"])[0])}</text><text x="0" y="{y+19}" font-size="12">{e(cell_lines(c["cell"])[1])}</text><text x="0" y="{y+36}" font-size="11" fill="#516074">{e(c["cell"])}</text><line x1="{x(lo)}" x2="{x(hi)}" y1="{y-5}" y2="{y-5}" stroke="#197b9a" stroke-width="4"/><circle cx="{x(c["median_paired_delta_ms"])}" cy="{y-5}" r="5" fill="#183d6e"/>')
parts.append(f'<text x="400" y="{height-5}" font-size="13">−{bound:.1f} ms</text><text x="695" y="{height-5}" font-size="13">0</text><text x="990" y="{height-5}" font-size="13">+{bound:.1f} ms</text></svg>')
parts.append('<div class="scroll"><table><thead><tr><th>Cell</th><th>Pairs</th><th>Median difference ms</th><th>Exploratory interval ms</th></tr></thead><tbody>')
for c in cells: parts.append(f'<tr><td>{cell_html(c["cell"])}</td><td>{c["pairs"]}</td><td>{fmt(c["median_paired_delta_ms"])}</td><td>{" to ".join(fmt(x) for x in c["exploratory_pair_bootstrap_95"])}</td></tr>')
parts.append('</tbody></table></div></section><section><h2>What the comparison can decide</h2><p>Use these measurements to locate input backlog, expensive cache rebuilds and scheduling stalls. Any recommendation remains conditional on visual quality and the later optical test. Synchronous replacement caches queue incoming input during rebuilding; asynchronous replacement is deferred for both adapters.</p><table><tr><th>Approach</th><th>Advantages</th><th>Costs and limits</th></tr><tr><td>Skia / Metal</td><td>Explicit GPU submission and separate Metal observations; path to shared rendering across platforms.</td><td>Additional bundled engine and GPU resources. Metal callbacks do not measure photons; drawable waits and queueing matter.</td></tr><tr><td>AppKit / Core Graphics</td><td>System drawing API, native AppKit integration, no bundled Skia renderer.</td><td>Drawing may be deferred after callback return. Raster/compositor completion is not exposed by this measurement; a short callback cannot establish lower physical latency.</td></tr></table></section>')
parts.append('<section><h2>Every accepted run</h2><p>p95 values in milliseconds. The full JSON retains p50, p95, exploratory p99, maxima, callback diagnostics and host aggregate Rust advance totals. Frame snapshots are not summed as Rust work.</p><div class="scroll"><table><tr><th>Run</th><th>Scheduled → receipt</th><th>Receipt → first draw</th><th>Scheduled → first draw</th></tr>')
for name,r in d['runs'].items(): parts.append('<tr><td>'+e(name)+'</td>'+''.join('<td>'+fmt(r['metrics'][k]['p95'])+'</td>' for k in ('scheduled_to_receipt_ms','receipt_to_first_draw_ms','scheduled_to_first_draw_ms'))+'</tr>')
parts.append('</table></div></section><section><h2>Every matched pair</h2><div class="scroll"><table><tr><th>Pair</th><th>CG − Skia p95 ms</th></tr>')
for pair in d['pairs']: parts.append(f'<tr><td>{e(pair["pair_id"])}</td><td>{fmt(pair["delta_p95_cg_minus_skia_ms"])}</td></tr>')
parts.append('</table></div></section><section><h2>Measured process CPU and callback wall time</h2><p>Process user and system CPU sum execution across all process threads from the measured replay epoch to finish entry. They exclude initialization, warm-up, idle, GPU retirement, capture and artifact serialization. External WindowServer CPU and GPU execution are not included. Draw callback totals are synchronous wall durations including drawable waits and painter calls; they are not CPU utilization. Missing values remain unknown (—), never zero.</p><div class="scroll"><table><tr><th>Run</th><th>User CPU s</th><th>System CPU s</th><th>Draw wall total ms</th><th>Draw wall max ms</th><th>Draw count</th></tr>')
for name,r in d['runs'].items():
    f=r.get('resource_observations',{}).get('final',{})
    parts.append('<tr><td>'+e(name)+'</td>'+''.join('<td>'+fmt(f.get(k))+'</td>' for k in ('measured_cpu_user_s','measured_cpu_system_s','draw_cpu_total_ms','draw_cpu_max_ms','draw_cpu_count'))+'</tr>')
parts.append('</table></div></section><section><h2>CPU, memory, thermal and power observations</h2><p>RSS is a process-lifetime peak including initialization and untimed capture. It excludes distinct GPU and WindowServer allocation accounting. Thermal changes are reported rather than silently discarded; power mode must remain consistent within matched pairs. These are observations, not measured energy consumption.</p><details><summary>Per-run metadata</summary><pre>'+e(json.dumps({r['config']['id']:r.get('resource_observations',{}) for r in list(d['runs'].values())+d.get('failed',[])},indent=2))+'</pre></details>')
parts.append('</section><section><h2>Frozen collection identity</h2><pre>'+e(json.dumps(d.get('collection_identity',{}),indent=2))+'</pre></section><section><h2>Pending and rejected evidence</h2><details><summary>Pending run IDs</summary><pre>'+e('\n'.join(d['pending']))+'</pre></details><pre>'+e(json.dumps(d['invalid'],indent=2))+'</pre><p>Skipped drawing snapshots are not lost samples: acceptance requires every expected sample in the delivery ledger and a subsequent first drawing representation. Final captures are untimed painter/readback proxies; they are not proof of presented pixels. OS visibility flags do not establish absence of every partial occluder. Visibility checks run on the main queue and can miss transient occlusion while that queue is blocked; they are not continuous proof of visibility.</p></section></main></html>')
Path(a.output).write_text('\n'.join(parts)); print(a.output)
