#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo_root"
export CARGO_TARGET_DIR="$repo_root/target/linux"
cargo fmt --manifest-path apps/linux/Cargo.toml -- --check
cargo clippy --locked --manifest-path apps/linux/Cargo.toml -- -D warnings
cargo test --locked --manifest-path apps/linux/Cargo.toml
./scripts/build-linux
