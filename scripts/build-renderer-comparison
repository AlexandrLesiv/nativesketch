#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
case "${1:-release}" in release|debug) ;; *) echo 'usage: build-renderer-comparison [release|debug] [both|skia|vello|baseline]' >&2; exit 2;; esac
[ "$#" -le 2 ] || exit 2
if [ "$#" -eq 2 ]; then
  exec "$ROOT/experiments/renderer-comparison/build-host" "$1" "$2"
fi
exec "$ROOT/experiments/renderer-comparison/build-host" "${1:-release}"
