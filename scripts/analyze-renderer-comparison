#!/usr/bin/env python3
"""Strict schema-v1 validation and descriptive per-process/paired summaries."""
import argparse
import csv
import json
import math
from pathlib import Path
import sys

FIELDS = 'phase frame_index state_hash input_ms outline_ms scene_ms acquire_ms render_submit_ms present_enqueue_ms completion_wait_ms service_ms cpu_frame_start_s cpu_submit_s gpu_span_ms gpu_start_s gpu_end_s presented_s gpu_missing_reason present_missing_reason'.split()
METRICS = [f for f in FIELDS if f.endswith('_ms')]

def distribution(values):
    if not values:
        return {'count': 0, 'p50': None, 'p95': None, 'p99': None, 'max': None}
    ordered = sorted(values)
    return dict(count=len(values), **{f'p{p}': ordered[max(0, math.ceil(p / 100 * len(ordered)) - 1)] for p in (50,95,99)}, max=ordered[-1])

def validate(path):
    m = json.loads((path / 'manifest.json').read_text())
    required = 'schema_version status backend backend_variant gpu_timing fixture width height mode warmup frames_requested duration_seconds repeat_id source_revision source_diff_hash build dependencies runtime display power timing_provenance unsupported fixture_hash input_hash image_hash init_ms first_use completed_sample_count'.split()
    missing = set(required) - m.keys()
    if missing: raise ValueError(f'{path}: missing manifest fields {sorted(missing)}')
    if m['schema_version'] != 1 or m['status'] != 'complete': raise ValueError(f'{path}: incompatible or incomplete manifest')
    host = json.loads((path / 'host-status.json').read_text())
    if host.get('status') != 'complete': raise ValueError(f'{path}: native host did not complete: {host.get("status")}')
    if 'lifecycle_start' in host or 'lifecycle_start' in m['runtime']:
        if host.get('activity_held_through_output') is not True:
            raise ValueError('native activity assertion was not held through output')
        required_options = {'userInitiated','latencyCritical','idleDisplaySleepDisabled'}
        if not required_options.issubset(set(host.get('activity_options',[]))):
            raise ValueError('missing native activity assertion options')
        events = host.get('lifecycle_events')
        if not isinstance(events,list) or any(event.get('invalidating') is not False for event in events):
            raise ValueError('native lifecycle invalidating event or incomplete event record')
        for phase in ('lifecycle_start','lifecycle_end'):
            state = host.get(phase,{})
            if any(state.get(key) is not True for key in ('window_visible','window_unoccluded','session_on_console')) or any(state.get(key) is not False for key in ('window_miniaturized','session_resigned','system_sleeping','screens_sleeping','display_asleep')):
                raise ValueError(f'invalid native lifecycle state: {phase}')
    if m['backend'] not in ('skia','vello') or m['mode'] not in ('completion','paced'): raise ValueError('invalid backend/mode')
    if m['gpu_timing'] not in ('on','off'): raise ValueError('invalid GPU timing setting')
    if (m['repeat_id'].startswith(('primary-', 'sustained-')) or m['duration_seconds'] is not None) and m['gpu_timing'] != 'on':
        raise ValueError('primary/sustained trials require GPU timing on')
    with (path / 'frames.csv').open(newline='') as f:
        reader = csv.DictReader(f)
        if reader.fieldnames != FIELDS: raise ValueError(f'{path}: CSV schema mismatch')
        rows = list(reader)
    seen = set()
    phases = {p: [] for p in ('first-use','warmup','measured')}
    for row in rows:
        phase = row['phase']
        index = int(row['frame_index'])
        key = (phase,index)
        if phase not in phases or index < 0 or key in seen or not row['state_hash']: raise ValueError('invalid/duplicate frame identity')
        seen.add(key)
        for field in FIELDS:
            if field.endswith(('_ms','_s')):
                if row[field] == '':
                    if field not in ('gpu_span_ms','gpu_start_s','gpu_end_s','presented_s'): raise ValueError(f'missing required timing {field}')
                    row[field] = None
                else:
                    row[field] = float(row[field])
                    if not math.isfinite(row[field]) or row[field] < 0: raise ValueError(f'invalid timing {field}')
        gpu = [row[k] for k in ('gpu_span_ms','gpu_start_s','gpu_end_s')]
        if any(x is None for x in gpu) and not (all(x is None for x in gpu) and row['gpu_missing_reason']): raise ValueError('partial GPU timing or missing reason')
        if row['presented_s'] is not None and row['presented_s'] <= 0: raise ValueError('invalid zero presentation timestamp')
        if row['presented_s'] is None and not row['present_missing_reason']: raise ValueError('missing presentation reason')
        if row['cpu_submit_s'] < row['cpu_frame_start_s']: raise ValueError('reversed CPU timestamps')
        if gpu[1] is not None and gpu[2] < gpu[1]: raise ValueError('reversed GPU timestamps')
        phases[phase].append(row)
    for phase, expected in (('first-use',1),('warmup',m['warmup']),('measured',m['completed_sample_count'])):
        values = phases[phase]
        if len(values) != expected or sorted(int(r['frame_index']) for r in values) != list(range(expected)): raise ValueError(f'{phase}: frame count/sequence mismatch')
    if not phases['measured']: raise ValueError('no measured frames')
    if m['duration_seconds'] is None and m['completed_sample_count'] != m['frames_requested']: raise ValueError('partial fixed-frame run')
    if m['duration_seconds'] is not None:
        duration = m['duration_seconds']
        elapsed = m.get('measured_elapsed_s')
        if not isinstance(duration,(int,float)) or not math.isfinite(duration) or duration <= 0:
            raise ValueError('invalid requested sustained duration')
        if not isinstance(elapsed,(int,float)) or not math.isfinite(elapsed) or elapsed < duration:
            raise ValueError('truncated sustained duration or missing measured_elapsed_s')
    readback = json.loads((path / 'readback.json').read_text())
    if readback.get('width') != m['width'] or readback.get('height') != m['height']: raise ValueError('readback dimension mismatch')
    if not (path / 'final.png').is_file() or not (path / 'run.log').is_file(): raise ValueError('missing image/log evidence')
    return m, phases

def analyze(paths):
    runs, pairs = [], {}
    for path in paths:
        m, phases = validate(path)
        metrics = {k: distribution([r[k] for r in phases['measured'] if r[k] is not None]) for k in METRICS}
        run = dict(path=str(path), backend=m['backend'], gpu_timing=m['gpu_timing'], fixture=m['fixture'], mode=m['mode'], width=m['width'], height=m['height'], repeat_id=m['repeat_id'], source_revision=m['source_revision'], metrics=metrics, first_use=m['first_use'], unsupported=m['unsupported'], actual_presentation_deadline_misses=None, actual_presentation_deadline_missing_reason='No display deadline classification in schema v1')
        refresh = m['display'].get('refresh_hz')
        run['service_budget_overruns'] = {'count': sum(r['service_ms'] > 1000/refresh for r in phases['measured']), 'denominator': len(phases['measured']), 'budget_ms':1000/refresh} if isinstance(refresh,(int,float)) and refresh > 0 else None
        starts = [r['cpu_frame_start_s'] for r in phases['measured']]
        if any(y < x for x,y in zip(starts,starts[1:])): raise ValueError('nonmonotonic frame starts')
        run['measured_frames'] = len(starts)
        run['measured_elapsed_s'] = m.get('measured_elapsed_s')
        presentations = sorted(r['presented_s'] for r in phases['measured'] if r['presented_s'] is not None)
        run['presentation_callback_count'] = len(presentations)
        run['presentation_interval_ms'] = distribution([(y-x)*1000 for x,y in zip(presentations,presentations[1:])])
        run['presentation_interval_definition'] = 'Observed presentation callback timestamp intervals; missing callbacks can span multiple frames. Not a deadline miss classification.'
        run['measured_start_span_s'] = starts[-1]-starts[0]
        run['trace_cycle_coverage'] = {'cycle_frames':600 if m['fixture']=='panzoom' else (240 if m['fixture']=='live' else None), 'submitted_frames':len(starts)}
        memory_path = path/'memory.csv'
        memory = []
        if memory_path.exists():
            with memory_path.open(newline='') as memory_file:
                for sample in csv.DictReader(memory_file):
                    if sample['rss_bytes']:
                        rss = int(sample['rss_bytes'])
                        if rss < 0: raise ValueError('negative RSS sample')
                        memory.append(rss)
        run['sampled_rss_bytes'] = distribution(memory)
        run['sampled_rss_definition'] = 'Out-of-band process resident set across process lifetime; sampled maximum is not OS peak, footprint, or GPU memory'
        run['cpu_frame_interval_ms'] = distribution([(y-x)*1000 for x,y in zip(starts,starts[1:])])
        run['frame_interval_definition'] = 'Consecutive CPU frame starts; includes retirement backpressure only when host records start before retirement wait, see timing provenance'
        runs.append(run)
        key = (m['fixture'], m['width'],m['height'],m['mode'],m['repeat_id'],m['duration_seconds'])
        pair = pairs.setdefault(key,{})
        if m['backend'] in pair: raise ValueError(f'duplicate backend in pair {key}')
        pair[m['backend']] = (m,phases,run)
    paired = []
    for key, pair in pairs.items():
        if set(pair) != {'skia','vello'}: raise ValueError(f'unpaired trial {key}')
        a,b = pair['skia'],pair['vello']
        for field in ('fixture_hash','input_hash','image_hash','source_revision','source_diff_hash','gpu_timing'):
            if a[0][field] != b[0][field]: raise ValueError(f'pair mismatch {field}')
        # Sustained runs can complete different frame counts. Their shared prefix must agree.
        for phase in ('first-use','warmup','measured'):
            for x,y in zip(a[1][phase],b[1][phase]):
                if x['state_hash'] != y['state_hash']: raise ValueError('paired state hash mismatch')
        deltas = {metric: {p: (b[2]['metrics'][metric][p]-a[2]['metrics'][metric][p]) if a[2]['metrics'][metric][p] is not None and b[2]['metrics'][metric][p] is not None else None for p in ('p50','p95','p99','max')} for metric in METRICS}
        paired.append({'cell':list(key),'vello_minus_skia_ms':deltas})
    variation = {}
    for pair in paired:
        cell = pair['cell']
        key = json.dumps(cell[:4]+cell[5:])
        group = variation.setdefault(key, {metric:{p:[] for p in ('p50','p95','p99','max')} for metric in METRICS})
        for metric,stats in pair['vello_minus_skia_ms'].items():
            for p,value in stats.items():
                if value is not None: group[metric][p].append(value)
    paired_variation = {key:{metric:{p:dict(distribution(values), minimum=min(values) if values else None) for p,values in stats.items()} for metric,stats in metrics.items()} for key,metrics in variation.items()}
    return {'paired_delta_variation_ms':paired_variation,'schema_version':1,'quantiles':'nearest rank per process, never pooled','caution':'600-frame p99 has few tail observations; paired variation and longer symmetric trials are needed for uncertain conclusions. GPU spans include scheduling/CPU gaps, not pure execution. Service overruns are not display misses.','runs':runs,'paired':paired}

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('root',type=Path)
    parser.add_argument('--output',type=Path)
    args = parser.parse_args()
    try:
        paths = sorted(p.parent for p in args.root.glob('*/manifest.json'))
        if not paths: raise ValueError('no trial manifests')
        suite_path = args.root / 'suite.json'
        if suite_path.exists():
            suite = json.loads(suite_path.read_text())
            if suite.get('status') not in ('running','complete') or suite.get('completed') != len(suite.get('trials',[])) or len(paths) != len(suite.get('trials',[])):
                raise ValueError('incomplete/failed suite; preserve partial evidence without claiming completion')
        result = analyze(paths)
        if suite_path.exists():
            if suite.get('replay'):
                result['coverage'] = {key:suite[key] for key in ('replay','source_suite','source_suite_sha256','source_revisions','requested_trial_indices','original_trial_indices','original_trial_count','coverage')}
            if suite.get('gpu_timing') not in ('on','off') or any(run['gpu_timing'] != suite['gpu_timing'] for run in result['runs']):
                raise ValueError('suite GPU timing setting missing or inconsistent with trials')
            if suite.get('suite') in ('primary','sustained') and suite['gpu_timing'] != 'on':
                raise ValueError('primary/sustained suites require GPU timing on')
        output = args.output or args.root / 'summary.json'
        output.write_text(json.dumps(result,indent=2,allow_nan=False)+'\n')
        print(output)
    except (ValueError,KeyError,OSError,TypeError) as e:
        print(f'analysis failed: {e}',file=sys.stderr)
        return 1
    return 0
if __name__ == '__main__': sys.exit(main())
