#!/usr/bin/env python3
"""Run fresh-process paired trials serially; never silently reduce a declared matrix."""
import argparse
import datetime
import json
import hashlib
import os
from pathlib import Path
import subprocess
import sys
import time
import threading

FIXTURES = ['live','dense100','dense1000','dense5000','panzoom','alpha','clip','image']

def matrix(suite):
    cells = [('live',1600,1000,'completion')] if suite == 'pilot' else ([('panzoom',1600,1000,'paced')] if suite == 'sustained' else [(f,w,h,m) for f in FIXTURES for w,h in [(1600,1000),(2560,1600)] for m in ['completion','paced']])
    repeats = {'pilot':1,'primary':5,'sustained':3}[suite]
    return [dict(fixture=f,width=w,height=h,mode=m,repeat_id=f'{suite}-{r}',backend=b) for f,w,h,m in cells for r in range(repeats) for b in (['skia','vello'] if r % 2 == 0 else ['vello','skia'])]

def replay_plan(suite, source, selection):
    """Replay whole adjacent backend pairs, retaining the original matrix indices."""
    original = json.loads((source / 'suite.json').read_text())
    expected = matrix(suite)
    if original.get('suite') != suite or original.get('replay'):
        raise ValueError('replay source must be an original full suite of the selected type')
    if original.get('status') != 'complete' or original.get('completed') != len(expected) or original.get('trials') != expected:
        raise ValueError('replay source is incomplete or its trial matrix is inconsistent')
    tokens = selection.split(',')
    if not tokens or any(not token.strip().isascii() or not token.strip().isdigit() for token in tokens):
        raise ValueError('trial indices must be comma-separated nonnegative integers')
    requested = [int(token.strip()) for token in tokens]
    if len(requested) != len(set(requested)) or any(i >= len(expected) for i in requested):
        raise ValueError('duplicate or out-of-range trial index')
    indices = sorted({j for i in requested for j in (i // 2 * 2, i // 2 * 2 + 1)})
    # Check every original result is present and complete, without modifying old evidence.
    manifests = list(source.glob('*/manifest.json'))
    if len(manifests) != len(expected): raise ValueError('replay source has missing or extra trial manifests')
    revisions = set()
    for i,trial in enumerate(expected):
        directory = trial_name(i,trial)
        m = json.loads((source / directory / 'manifest.json').read_text())
        if m.get('status') != 'complete' or any(m.get(k) != v for k,v in trial.items()):
            raise ValueError(f'replay source trial {i} is incomplete or mismatched')
        revisions.add(m.get('source_revision'))
    if None in revisions: raise ValueError('replay source missing source revision')
    metadata = {'replay':True, 'source_suite':str(source), 'source_suite_sha256':hashlib.sha256((source/'suite.json').read_bytes()).hexdigest(), 'source_revisions':sorted(revisions), 'requested_trial_indices':requested, 'original_trial_indices':indices, 'original_trial_count':len(expected), 'coverage':'targeted paired replay only; not a complete matrix; do not silently pool with original revisions'}
    return [(i,expected[i]) for i in indices], metadata

def trial_name(i, trial):
    return f'{i:03d}-{trial["fixture"]}-{trial["width"]}-{trial["mode"]}-{trial["repeat_id"]}-{trial["backend"]}'

def observation():
    result = {'utc':datetime.datetime.now(datetime.timezone.utc).isoformat()}
    for name,args in [('power',['pmset','-g','batt']),('thermal',['pmset','-g','therm'])]:
        try:
            p = subprocess.run(args,capture_output=True,text=True,timeout=10)
            result[name] = {'exit_code':p.returncode,'text':p.stdout.strip(),'error':p.stderr.strip()}
        except (OSError,subprocess.TimeoutExpired) as e: result[name] = {'unavailable':str(e)}
    return result

def sample_memory(pid, stop, output, interval):
    with output.open('w') as f:
        f.write('monotonic_s,rss_bytes,missing_reason\n')
        while not stop.is_set():
            now = time.monotonic()
            try:
                p = subprocess.run(['ps','-o','rss=','-p',str(pid)],capture_output=True,text=True,timeout=2)
                rss = int(p.stdout.strip()) * 1024
                f.write(f'{now},{rss},\n')
            except (ValueError,OSError,subprocess.TimeoutExpired): f.write(f'{now},,process unavailable\n')
            f.flush()
            stop.wait(interval)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--suite',choices=['pilot','primary','sustained'],required=True)
    parser.add_argument('--output',type=Path,required=True)
    root = Path(__file__).resolve().parent.parent
    parser.add_argument('--binary',type=Path,default=root/'artifacts/renderer-comparison-build/RendererComparison.app/Contents/MacOS/RendererComparison')
    parser.add_argument('--dry-run',action='store_true')
    parser.add_argument('--replay-from',type=Path,help='Complete original suite; preserve it and write selected pairs to a fresh output directory')
    parser.add_argument('--trial-indices',help='Original comma-separated indices; each expands to both members of its backend pair')
    parser.add_argument('--memory-sampling',choices=['on','off'],default='on')
    parser.add_argument('--memory-interval',type=float,default=.25)
    parser.add_argument('--window-seconds',type=float,default=14400)
    args = parser.parse_args()
    if not (args.memory_interval >= .05 and args.memory_interval < 60 and 0 < args.window_seconds <= 14400): parser.error('invalid sampling interval or window (maximum four hours)')
    output = args.output.resolve()
    gpu_timing = os.environ.get('RENDERER_GPU_TIMING', 'on')
    if gpu_timing not in ('on', 'off'): parser.error('RENDERER_GPU_TIMING must be on or off')
    if args.suite in ('primary', 'sustained') and gpu_timing != 'on':
        parser.error('RENDERER_GPU_TIMING=off is only allowed for pilot instrumentation comparisons; primary/sustained require on')
    if (args.replay_from is None) != (args.trial_indices is None): parser.error('--replay-from and --trial-indices must be supplied together')
    indexed_plan = list(enumerate(matrix(args.suite)))
    replay_metadata = {}
    if args.replay_from is not None:
        try: indexed_plan, replay_metadata = replay_plan(args.suite,args.replay_from.resolve(),args.trial_indices)
        except (ValueError,OSError,TypeError,KeyError) as error: parser.error(str(error))
    plan = [trial for _,trial in indexed_plan]
    if args.dry_run:
        print(json.dumps({'suite':args.suite,'gpu_timing':gpu_timing,'trial_count':len(plan),'trials':plan,**replay_metadata},indent=2)); return 0
    # Keep disposable evidence under the repository ignored artifact tree.
    if not output.is_relative_to(root/'artifacts'/'renderer-comparison'): parser.error('output must be under repository artifacts/renderer-comparison/')
    if output.exists(): parser.error('output exists: preserve it and choose a fresh run directory')
    if not args.binary.is_file(): parser.error('build the native binary first')
    output.mkdir(parents=True)
    metadata = {'schema_version':1,'suite':args.suite,'gpu_timing':gpu_timing,'status':'running','trials':plan,'completed':0,'memory_sampling':args.memory_sampling,'memory_interval_s':args.memory_interval,'memory_definition':'external ps resident set, not footprint or GPU allocation','start':observation(),**replay_metadata}
    def save(): (output/'suite.json').write_text(json.dumps(metadata,indent=2)+'\n')
    save()
    start = time.monotonic()
    inhibitor = None
    try:
        if sys.platform == 'darwin': inhibitor = subprocess.Popen(['caffeinate','-di','-w',str(os.getpid())])
        for i,trial in indexed_plan:
            remaining = args.window_seconds - (time.monotonic()-start)
            if remaining <= 0: raise RuntimeError('measurement window expired; pending cells retained in suite manifest')
            path = output / trial_name(i,trial)
            path.mkdir()
            command = [str(args.binary.resolve())]
            for key,value in trial.items(): command += ['--'+key.replace('_','-'),str(value)]
            command += ['--warmup','120','--output',str(path)]
            command += ['--duration-seconds','180'] if args.suite == 'sustained' else ['--frames','600']
            info = {'command':command,'before':observation()}
            stop = threading.Event()
            with (path/'launcher.log').open('w') as log:
                process = subprocess.Popen(command,stdout=log,stderr=subprocess.STDOUT)
                sampler = threading.Thread(target=sample_memory,args=(process.pid,stop,path/'memory.csv',args.memory_interval),daemon=True) if args.memory_sampling == 'on' else None
                if sampler: sampler.start()
                try: code = process.wait(timeout=remaining)
                except (subprocess.TimeoutExpired,KeyboardInterrupt):
                    process.terminate()
                    try: process.wait(timeout=10)
                    except subprocess.TimeoutExpired: process.kill(); process.wait()
                    raise
                finally:
                    stop.set()
                    if sampler: sampler.join(timeout=3)
                    info['after'] = observation()
                    info['elapsed_s'] = time.monotonic()-start
                    (path/'launcher.json').write_text(json.dumps(info,indent=2)+'\n')
            if code: raise RuntimeError(f'trial failed ({code}): {path}')
            # Load the sibling analyzer without requiring a package or installed dependency.
            import runpy
            runpy.run_path(str(root/'scripts/analyze-renderer-comparison'))['validate'](path)
            metadata['completed'] += 1
            save()
            print(f'{metadata["completed"]}/{len(plan)} {path.name}',flush=True)
        subprocess.run([sys.executable,str(root/'scripts/analyze-renderer-comparison'),str(output)],check=True)
        metadata['status'] = 'complete'
        return 0
    except (Exception,KeyboardInterrupt) as e:
        metadata['status'] = 'failed'
        metadata['error'] = str(e) or type(e).__name__
        print(f'run failed: {metadata["error"]}',file=sys.stderr)
        return 1
    finally:
        metadata['elapsed_s'] = time.monotonic()-start
        metadata['end'] = observation()
        save()
        if inhibitor: inhibitor.terminate(); inhibitor.wait()

if __name__ == '__main__': sys.exit(main())
