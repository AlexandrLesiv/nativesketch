#!/usr/bin/env python3
"""Plot paced comparison results; bars are medians of five per-process p95 values."""
import argparse,json,pathlib

def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('results',type=pathlib.Path)
    p.add_argument('--output',type=pathlib.Path,required=True)
    args=p.parse_args()
    import matplotlib
    matplotlib.use('Agg')
    matplotlib.rcParams['svg.hashsalt'] = 'native-sketch-renderer-comparison-v1'
    import matplotlib.pyplot as plt
    data=json.loads(args.results.read_text())
    order=['live','dense100','dense1000','dense5000','panzoom','alpha','clip','image']
    labels=['Live','100 strokes','1k strokes','5k strokes','Pan/zoom','Translucency','Clips','Image']
    colors={'skia':'#245b91','vello':'#c96821'}
    names={'skia':'Skia Ganesh/Metal','vello':'Vello GPU Sparse Strips'}
    fig,axes=plt.subplots(2,2,figsize=(15,9),sharex=True)
    for col,width in enumerate([1600,2560]):
        cells={c['fixture']:c for c in data['cells'] if c['width']==width and c['mode']=='paced'}
        if set(cells)!=set(order): raise ValueError('Expected complete paced fixture matrix')
        for row,metric in enumerate(['service_without_acquire_ms','cpu_frame_interval_ms']):
            ax=axes[row,col]
            for backend,offset in [('skia',-.19),('vello',.19)]:
                values=[cells[f]['backends'][backend]['metrics'][metric]['p95'] for f in order]
                med=[v['median'] for v in values]
                err=[[v['median']-v['min'] for v in values],[v['max']-v['median'] for v in values]]
                ax.bar([x+offset for x in range(8)],med,.36,yerr=err,capsize=2.5,color=colors[backend],label=names[backend],error_kw={'elinewidth':1})
            ax.set_yscale('log');ax.grid(axis='y',which='major',alpha=.25);ax.set_axisbelow(True)
            ax.set_xticks(range(8),labels,rotation=30,ha='right')
            ax.set_ylabel('Milliseconds (log scale)')
            label='Service excluding drawable acquisition' if row==0 else 'Consecutive CPU frame starts'
            ax.set_title(f'{width} × {1000 if width==1600 else 1600}: {label}',fontsize=11)
            if row==1: ax.axhline(1000/120,color='#555555',linestyle=':',linewidth=1)
    handles,legend_labels=axes[0,0].get_legend_handles_labels()
    fig.legend(handles,legend_labels,loc='upper center',bbox_to_anchor=(.5,.94),ncol=2,frameon=False)
    fig.suptitle('Original comparison — Apple M2 Pro / native-paced mode',fontsize=16,y=.985)
    fig.text(.04,.035,'Bars: median of five per-process p95 values. Whiskers: minimum–maximum across those five p95 values, not confidence intervals.\nService excludes drawable acquisition but can include internal backend waits; neither metric is physical pen latency. Dotted line: nominal 120 Hz period, not a deadline-miss test.',fontsize=9)
    fig.text(.04,.009,f"Includes presentation-state anomalies; see separate guarded replay. Source {data['source_revision'][:12]} • Skia-safe 0.153.3 • Vello GPU 0.3.0 • Metal • 600 measured frames per process",fontsize=9)
    fig.tight_layout(rect=(0,.085,1,.90))
    args.output.mkdir(parents=True,exist_ok=True)
    fig.savefig(args.output/'paced-comparison.png',dpi=180)
    fig.savefig(args.output/'paced-comparison.svg',metadata={'Date':None})
    svg = args.output/'paced-comparison.svg'
    svg.write_text('\n'.join(line.rstrip() for line in svg.read_text().splitlines())+'\n')
    (args.output/'plot-provenance.json').write_text(json.dumps({'matplotlib':matplotlib.__version__,'source_revision':data['source_revision'],'statistics':'median and min/max of five per-process p95 values; no pooled percentiles'},indent=2)+'\n')
    plt.close(fig)
    print(args.output/'paced-comparison.png')

if __name__=='__main__': main()
