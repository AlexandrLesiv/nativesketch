#!/usr/bin/env python3
"""Build a self-contained review report from retained task 002 evidence. No measurements."""
import base64
import hashlib
import html
import json
from pathlib import Path
from statistics import median
import sys

ROOT = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parents[1]
DATA = ROOT / 'docs/evidence/renderer-comparison'
original = json.loads((DATA / 'results.json').read_text())
replay = json.loads((DATA / 'guarded-replay.json').read_text())
E = html.escape
names = {'live':'Live drawing', 'dense100':'100 strokes', 'dense1000':'1,000 strokes', 'dense5000':'5,000 strokes', 'panzoom':'Pan & zoom', 'alpha':'Transparency', 'clip':'Nested clips', 'image':'Image + vectors'}
order = list(names)
colors = {'skia':'#176b87', 'vello':'#a64527'}
parts = []
def add(s): parts.append(s)
def table(headers, rows, caption):
    return '<div class="table-scroll" tabindex="0" role="region" aria-label="'+E(caption)+'"><table><caption>'+E(caption)+'</caption><thead><tr>'+''.join('<th scope="col">'+E(x)+'</th>' for x in headers)+'</tr></thead><tbody>'+''.join('<tr>'+''.join(('<th scope="row">' if i==0 else '<td>')+E(str(v))+('</th>' if i==0 else '</td>') for i,v in enumerate(row))+'</tr>' for row in rows)+'</tbody></table></div>'
def stat(c,b,metric='service_without_acquire_ms'): return c['backends'][b]['metrics'][metric]['p95']
def fmt(v): return f'{v:,.2f}'
def legend(): return '<div class="legend"><span><i class="skia"></i>Skia</span><span><i class="vello"></i>Vello GPU</span><span>Lower time is better</span></div>'
def chart(items, title, uid, unit='ms'):
    # Each item: label, Skia (median,min,max), Vello (median,min,max).
    width, left, right, rowh = 920, 180, 110, 76
    plot = width-left-right
    maximum=max(v[2] for _,*values in items for v in values)*1.04
    height=70+len(items)*rowh
    svg=[f'<svg viewBox="0 0 {width} {height}" role="img" aria-labelledby="{uid}-title {uid}-desc"><title id="{uid}-title">{E(title)}</title><desc id="{uid}-desc">Linear scale from zero. Paired labeled horizontal bars show Skia and Vello GPU. Lines show minimum to maximum when available. Exact values follow in a table.</desc>']
    for i in range(5):
        val=maximum*i/4; x=left+plot*i/4
        svg.append(f'<line x1="{x}" x2="{x}" y1="30" y2="{height-30}" stroke="#dbe2e3"/><text x="{x}" y="20" text-anchor="middle">{val:.1f}</text>')
    svg.append(f'<text x="{width-15}" y="20" text-anchor="end">{unit}</text>')
    for i,(label,s,v) in enumerate(items):
        y=46+i*rowh
        svg.append(f'<text x="{left-14}" y="{y+22}" text-anchor="end" class="row-label">{E(label)}</text>')
        for j,(b,vals) in enumerate([('skia',s),('vello',v)]):
            m,lo,hi=vals; yy=y+j*26
            svg.append(f'<rect x="{left}" y="{yy}" width="{plot*m/maximum}" height="19" rx="3" fill="{colors[b]}"/>')
            if lo!=hi:
                x1,x2=left+plot*lo/maximum,left+plot*hi/maximum
                svg.append(f'<path d="M{x1},{yy+9.5} H{x2} M{x1},{yy+5} V{yy+14} M{x2},{yy+5} V{yy+14}" stroke="#142a34" stroke-width="1.5"/>')
            svg.append(f'<text x="{left+plot*hi/maximum+9}" y="{yy+15}">{"S" if b=="skia" else "V"} {m:.2f}</text>')
    return '<div class="chart-scroll" tabindex="0" role="region" aria-label="'+E(title)+'">'+''.join(svg)+'</svg></div>'

def source_link(path,label):
    return f'<a href="https://github.com/AlexandrLesiv/nativesketch/blob/65e7b333f127415dfc15887fbbe614d0ada3f7ee/{path}">{label}</a>'

