in:25px 0}.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px}.card h3{margin:8px 0 18px;font-size:21px}.numbers{display:flex;flex-wrap:wrap;gap:12px 24px;line-height:1.2;margin:16px 0}.numbers b{font-size:32px;letter-spacing:-.04em;display:block}.numbers small{font-size:12px;font-weight:650}.s-text{color:var(--skia)}.v-text{color:var(--vello)}.two{display:grid;grid-template-columns:1fr 1fr;gap:24px}.notice{border-left:4px solid #b76924;background:#fff4e4;padding:17px 22px;margin:20px 0}.legend{display:flex;flex-wrap:wrap;gap:12px 25px;font-size:13px;margin:20px 0 10px}.legend span{display:flex;align-items:center;gap:7px}.legend i{display:inline-block;width:15px;height:15px;border-radius:3px}.skia{background:var(--skia)}.vello{background:var(--vello)}figure{margin:24px 0}.chart-scroll{overflow-x:auto;background:white;border:1px solid var(--line);border-radius:12px;padding:18px 10px}svg{width:100%;height:auto;min-width:680px;display:block}svg text{font:14px system-ui,sans-serif;fill:#263f49}svg .row-label{font-weight:650}.table-scroll{overflow:auto;margin:20px 0}table{width:100%;border-collapse:collapse;font-size:14px;background:white;font-variant-numeric:tabular-nums}caption{text-align:left;font-weight:650;padding:8px 0 12px;color:var(--muted)}th,td{text-align:right;padding:12px 14px;border-bottom:1px solid var(--line);vertical-align:top}th:first-child,td:first-child{text-align:left}thead th{background:#e8eeeb;font-size:12px}tbody th{font-weight:600}details{background:#fff;border:1px solid var(--line);border-radius:12px;padding:18px 22px;margin:16px 0}summary{cursor:pointer;font-weight:700;font-size:17px}details[open] summary{margin-bottom:18px}ul,ol{padding-left:22px}li{margin:8px 0}.pros{border-top:4px solid var(--skia)}.cons{border-top:4px solid var(--vello)}.quality img{display:block;width:100%;height:auto;border:1px solid var(--line);border-radius:8px}.quality summary{font-size:16px}.code,code{font-family:ui-monospace,SFMono-Regular,monospace;font-size:12px;overflow-wrap:anywhere}.foot{padding:35px 0 55px;font-size:13px;color:var(--muted)}.wide-text{max-width:920px}.platform td{text-align:left}.print{border:1px solid #8b9d99;border-radius:20px;background:transparent;padding:8px 15px;color:var(--ink);font:inherit;font-size:12px;cursor:pointer}.print:hover{background:white}
