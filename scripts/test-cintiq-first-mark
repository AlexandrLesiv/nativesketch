#!/usr/bin/env python3
"""Portable first-mark identity and batched-sample evidence tests; no native launches."""
import json
import runpy
import subprocess
import sys
import unittest
from pathlib import Path

HERE = Path(__file__).resolve().parent
BASE = runpy.run_path(str(HERE / 'test-cintiq-analysis'))
EXTRACT = runpy.run_path(str(HERE / 'extract-cintiq-first-mark'))
A, R = BASE['A'], BASE['R']


class FirstMarkTests(unittest.TestCase):
    def setUp(self):
        self.fixture = BASE['AnalysisTests']()
        self.fixture.setUp()
        self.root = self.fixture.root

    def tearDown(self):
        self.fixture.tearDown()

    def prepare(self, state='first-use'):
        config = next(c for c in R['matrix'](1, 3) if c['start_state'] == state)
        folder = self.fixture.fixture(config, start_id=7)
        manifest = A['read'](folder / 'manifest.json')
        manifest['initialization'] = [{'stage': 'replay_creation_and_reference_oracle', 'duration_ms': 12.5}]
        self.fixture.write(folder / 'manifest.json', manifest)
        epoch = 1234.5
        self.fixture.write(folder / 'deliveries.json', [dict(receipt_s=epoch + .025, epoch_s=epoch, first_sample_id=7, last_sample_id=9, sample_count=3)])
        self.fixture.write(folder / 'frames.json', [
            dict(frame=0, draw_start_s=epoch, epoch_s=epoch, total_samples=0, sample_id=0, draw_cpu_ms=0, cache_build_ms=0, host_launch_to_draw_ms=60),
            dict(frame=1, draw_start_s=epoch + .030, epoch_s=epoch, total_samples=3, sample_id=9, sample_age_at_draw_ms=10, draw_cpu_ms=5.5, cache_build_ms=3.2, host_launch_to_draw_ms=90),
        ])
        self.fixture.write(folder / 'collection-receipt.json', {name: A['digest'](folder / name) for name in EXTRACT['RECEIPT_FILES']})
        self.fixture.collection([config])
        checked = A['analyze_run'](folder, config, self.fixture.identity)
        analysis = self.root / 'validated-analysis.json'
        self.fixture.write(analysis, {'collection_identity': self.fixture.identity, 'accepted_runs': 1, 'runs': {config['id']: checked}})
        return analysis, folder

    def test_first_sample_not_latest_batched_sample(self):
        analysis, _ = self.prepare()
        result = EXTRACT['extract'](analysis, self.root)
        row = result['rows'][0]
        self.assertEqual(row['first_sample_id'], 7)
        self.assertAlmostEqual(row['scheduled_to_receipt_ms'], 25)
        self.assertAlmostEqual(row['receipt_to_draw_start_ms'], 5)
        self.assertAlmostEqual(row['scheduled_to_draw_start_ms'], 30)
        self.assertNotEqual(row['scheduled_to_draw_start_ms'], 10)
        self.assertEqual(row['first_frame_draw_wall_ms'], 5.5)
        self.assertEqual(row['first_frame_cache_build_ms'], 3.2)
        self.assertEqual(row['host_launch_to_first_measured_draw_start_ms'], 90)
        self.assertEqual(row['initialization_stages'][0]['duration_ms'], 12.5)
        self.assertEqual(result['analysis_sha256'], A['digest'](analysis))
        self.assertEqual(result['collection_sha256'], A['digest'](self.root / 'collection.json'))
        self.assertIn('camera pending', result['scope'])

    def test_after_idle_retains_host_launch_caveat(self):
        analysis, _ = self.prepare('after-idle')
        result = EXTRACT['extract'](analysis, self.root)
        self.assertEqual(result['rows'][0]['start_state'], 'after-idle')
        self.assertIn('warm-up, reset, cache preparation and idle waiting', result['host_launch_scope'])

    def test_missing_analysis_identity_rejected(self):
        analysis, _ = self.prepare()
        data = A['read'](analysis)
        del data['collection_identity']
        self.fixture.write(analysis, data)
        with self.assertRaises(KeyError):
            EXTRACT['extract'](analysis, self.root)

    def test_wrong_analysis_identity_rejected(self):
        analysis, _ = self.prepare()
        data = A['read'](analysis)
        data['collection_identity']['binary_sha256'] = 'other'
        self.fixture.write(analysis, data)
        with self.assertRaisesRegex(ValueError, 'identity mismatch'):
            EXTRACT['extract'](analysis, self.root)

    def test_missing_receipt_rejected(self):
        analysis, folder = self.prepare()
        (folder / 'collection-receipt.json').unlink()
        with self.assertRaises(OSError):
            EXTRACT['extract'](analysis, self.root)

    def test_changed_raw_artifact_rejected(self):
        analysis, folder = self.prepare()
        frames = A['read'](folder / 'frames.json')
        frames[-1]['cache_build_ms'] = 999
        self.fixture.write(folder / 'frames.json', frames)
        with self.assertRaisesRegex(ValueError, 'checksum mismatch'):
            EXTRACT['extract'](analysis, self.root)

    def test_changed_validated_analysis_rejected(self):
        analysis, _ = self.prepare()
        data = A['read'](analysis)
        next(iter(data['runs'].values()))['metrics']['scheduled_to_first_draw_ms']['p95'] = 999
        self.fixture.write(analysis, data)
        with self.assertRaisesRegex(ValueError, 'differs from accepted raw run'):
            EXTRACT['extract'](analysis, self.root)

    def test_modified_frozen_collection_rejected(self):
        analysis, _ = self.prepare()
        path = self.root / 'collection.json'
        path.write_text(path.read_text() + ' ')
        with self.assertRaisesRegex(ValueError, 'collection checksum mismatch'):
            EXTRACT['extract'](analysis, self.root)

    def test_warm_runs_do_not_become_first_use_evidence(self):
        analysis, _ = self.prepare('warm')
        self.assertEqual(EXTRACT['extract'](analysis, self.root)['rows'], [])

    def report_fixture(self):
        analysis, _ = self.prepare()
        data = A['read'](analysis)
        data.update(status='partial', declared_runs=1, attempted_runs=1, pending=[], invalid=[], failed_runs=0, failed=[], cells=[], pair_outcomes=[], pairs=[])
        self.fixture.write(analysis, data)
        first = self.root / 'first.json'
        self.fixture.write(first, EXTRACT['extract'](analysis, self.root))
        return analysis, first

    def render_report(self, analysis, first):
        return subprocess.run([sys.executable, str(HERE / 'build-cintiq-report'), str(analysis), '--first-mark', str(first), '--output', str(self.root / 'report.html')], capture_output=True, text=True)

    def test_report_keeps_first_sample_and_callback_boundaries(self):
        analysis, first = self.report_fixture()
        result = self.render_report(analysis, first)
        self.assertEqual(result.returncode, 0, result.stderr)
        report = (self.root / 'report.html').read_text()
        self.assertIn('<td>30.00</td><td>25.00</td><td>5.00</td><td>5.50</td><td>3.20</td>', report)
        self.assertIn('not sub-millisecond visible ink', report)
        self.assertIn('Component medians need not sum', report)

    def test_report_rejects_first_mark_from_other_analysis(self):
        analysis, first = self.report_fixture()
        analysis.write_text(analysis.read_text() + ' ')
        self.assertNotEqual(self.render_report(analysis, first).returncode, 0)
        self.assertFalse((self.root / 'report.html').exists())

    def test_report_rejects_missing_first_mark_row(self):
        analysis, first = self.report_fixture()
        data = A['read'](first)
        data['rows'] = []
        self.fixture.write(first, data)
        self.assertNotEqual(self.render_report(analysis, first).returncode, 0)
        self.assertFalse((self.root / 'report.html').exists())


if __name__ == '__main__':
    unittest.main()
