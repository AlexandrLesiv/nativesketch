#!/usr/bin/env python3
"""Derive an explicit replay from whole valid pairs; never modify source evidence."""
import argparse
import hashlib
import json
from pathlib import Path
import runpy
import shutil
import sys

ROOT = Path(__file__).resolve().parent.parent
EXPECTED = [58,59,70,71,72,73,224,225,226,227,228,229,230,231,232,233]
RUNNER = runpy.run_path(str(ROOT/'scripts/run-renderer-comparison'))
ANALYZER = runpy.run_path(str(ROOT/'scripts/analyze-renderer-comparison'))

def assemble(sources, output, expected=EXPECTED):
    if output.exists(): raise ValueError('output already exists; original evidence must never be overwritten')
    if len(set(sources)) != len(sources): raise ValueError('duplicate source suite')
    chosen, excluded, provenance = {}, [], []
    source_identity = None
    common = None
    elapsed = 0.0
    expected = sorted(expected)
    if any(i ^ 1 not in expected for i in expected): raise ValueError('expected indices must contain whole backend pairs')
    full = RUNNER['matrix']('primary')
    signatures = {}
    for source in sources:
        raw = (source/'suite.json').read_bytes()
        suite = json.loads(raw)
        if not suite.get('replay') or suite.get('suite') != 'primary' or suite.get('original_trial_count') != len(full):
            raise ValueError('input must be a targeted primary replay suite')
        identity = (suite['source_suite'],suite['source_suite_sha256'])
        if source_identity is None: source_identity = identity
        if identity != source_identity: raise ValueError('different original evidence sources')
        if hashlib.sha256((Path(identity[0])/'suite.json').read_bytes()).hexdigest() != identity[1]:
            raise ValueError('original suite identity changed')
        settings = tuple(suite.get(k) for k in ('gpu_timing','memory_sampling','memory_interval_s'))
        if settings[0] != 'on': raise ValueError('GPU timing must be on')
        if common is None: common = settings
        if common != settings: raise ValueError('mixed instrumentation settings')
        indices = suite['original_trial_indices']
        if len(indices) != len(set(indices)) or suite['trials'] != [full[i] for i in indices]:
            raise ValueError('source trial indices/matrix mismatch')
        valid, revisions = {}, set()
        for i in indices:
            path = source/RUNNER['trial_name'](i,full[i])
            try:
                m, _ = ANALYZER['validate'](path)
                if any(m.get(k) != v for k,v in full[i].items()): raise ValueError('trial identity differs from original matrix')
                if m['gpu_timing'] != 'on': raise ValueError('GPU timing disabled')
                valid[i] = (path,m)
                revisions.add(m['source_revision'])
            except (ValueError,OSError,KeyError,TypeError) as error:
                excluded.append({'source':str(source),'index':i,'path':str(path),'reason':str(error)})
        for i in sorted(valid):
            if i ^ 1 not in valid:
                excluded.append({'source':str(source),'index':i,'path':str(valid[i][0]),'reason':'counterpart incomplete or invalid; whole pair excluded'})
            elif i not in expected:
                excluded.append({'source':str(source),'index':i,'path':str(valid[i][0]),'reason':'outside explicitly requested coverage'})
            elif i % 2 == 0:
                pair = [valid[i],valid[i+1]]
                ANALYZER['analyze']([p for p,_ in pair])
                if i in chosen: raise ValueError(f'duplicate complete pair {i}/{i+1}; choose sources explicitly')
                for j,(path,m) in zip((i,i+1),pair):
                    settings_identity = {k:m[k] for k in ('source_revision','source_diff_hash','build','dependencies','display','quality','gpu_timing')}
                    settings_identity['runtime'] = {k:v for k,v in m['runtime'].items() if k != 'lifecycle_start'}
                    signature = json.dumps(settings_identity,sort_keys=True)
                    backend = m['backend']
                    if backend in signatures and signatures[backend] != signature: raise ValueError('mixed measured revisions/build/runtime/display/quality settings')
                    signatures[backend] = signature
                    chosen[j] = path
        elapsed += float(suite.get('elapsed_s',0))
        provenance.append({'source':str(source),'suite_sha256':hashlib.sha256(raw).hexdigest(),'status':suite['status'],'measured_source_revisions':sorted(revisions),'elapsed_s':suite.get('elapsed_s')})
    if sorted(chosen) != expected: raise ValueError(f'incomplete explicit coverage: missing {sorted(set(expected)-chosen.keys())}')
    summary = ANALYZER['analyze']([chosen[i] for i in expected])
    output.mkdir(parents=True)
    metadata = dict(schema_version=1,suite='primary',status='running',completed=0,trials=[full[i] for i in expected],replay=True,source_suite=source_identity[0],source_suite_sha256=source_identity[1],source_revisions=sorted({r['source_revision'] for r in summary['runs']}),requested_trial_indices=expected,original_trial_indices=expected,original_trial_count=len(full),coverage='Derived targeted paired replay only; not full matrix. Original evidence retained; no pooling across measured revisions.',gpu_timing=common[0],memory_sampling=common[1],memory_interval_s=common[2],elapsed_s=elapsed,elapsed_definition='Sum of supplied suite elapsed times including failed/incomplete trials; not selected-trial rendering time',assembly_sources=provenance,excluded_trials=excluded)
    def save(): (output/'suite.json').write_text(json.dumps(metadata,indent=2)+'\n')
    save()
    try:
        for i in expected:
            shutil.copytree(chosen[i],output/RUNNER['trial_name'](i,full[i]))
            metadata['completed'] += 1
        result = ANALYZER['analyze']([output/RUNNER['trial_name'](i,full[i]) for i in expected])
        result['coverage'] = {k:metadata[k] for k in ('replay','source_suite','source_suite_sha256','source_revisions','requested_trial_indices','original_trial_indices','original_trial_count','coverage')}
        (output/'summary.json').write_text(json.dumps(result,indent=2,allow_nan=False)+'\n')
        metadata['status'] = 'complete'
    except Exception:
        metadata['status'] = 'failed'
        raise
    finally: save()
    return metadata

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source',type=Path,action='append',required=True)
    parser.add_argument('--output',type=Path,required=True)
    args=parser.parse_args()
    output=args.output.resolve()
    if not output.is_relative_to(ROOT/'artifacts/renderer-comparison'): parser.error('output must be under repository artifacts/renderer-comparison')
    try:
        result=assemble([p.resolve() for p in args.source],output)
        print(f'Assembled {result["completed"]} explicitly selected trials: {output}')
    except (ValueError,OSError,KeyError,TypeError) as error:
        print(f'assembly failed: {error}',file=sys.stderr);return 1
    return 0
if __name__=='__main__': sys.exit(main())
