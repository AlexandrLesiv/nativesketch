{
  "name": "native-sketch-tooling",
  "private": true,
  "type": "module",
  "engines": {"node": "24.12.0"},
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --project tsconfig.scripts.json",
    "lint": "oxlint --type-aware scripts apps/web/vite.config.mjs",
    "format:check": "oxfmt --check scripts/**/*.mjs scripts/*.mjs apps/web/vite.config.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs scripts/quality/*.test.mjs"
  }
}
