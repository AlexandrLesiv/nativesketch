{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Sketch feature v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "invariants": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ownerTask": {
            "type": "string",
            "pattern": "^[0-9]{3}$"
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "type": "string",
                  "minLength": 1
                },
                "pointerWidth": {
                  "enum": [
                    32,
                    64
                  ]
                }
              },
              "required": [
                "platform",
                "level"
              ]
            },
            "minItems": 1
          },
          "testIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "automation": {
            "enum": [
              "planned",
              "partial",
              "implemented",
              "unsupported",
              "not-applicable"
            ]
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "ownerTask": {
                  "type": "string",
                  "pattern": "^[0-9]{3}$"
                }
              },
              "required": [
                "reason",
                "ownerTask"
              ]
            }
          }
        },
        "required": [
          "id",
          "expected",
          "invariants",
          "ownerTask",
          "requirements",
          "testIds",
          "automation",
          "gaps"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "description",
    "sourceRevision",
    "cases"
  ]
}
