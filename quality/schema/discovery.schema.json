{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Sketch discovery v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirtyDiffSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "dirtyDiffSha256"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "pointerWidth": {
            "enum": [
              32,
              64
            ]
          },
          "binarySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "testBinarySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "runner",
          "level",
          "platform",
          "binarySha256"
        ]
      }
    },
    "scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "runner",
          "platform",
          "level"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "tests"
  ]
}
