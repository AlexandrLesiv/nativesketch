{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native Sketch execution v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirtyDiffSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "dirtyDiffSha256"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "testId": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "blocked",
              "unsupported"
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "binarySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "testBinarySha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "toolchain": {
            "type": "string",
            "minLength": 1
          },
          "device": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "object",
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "valid",
              "reasons"
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "testId",
          "attempt",
          "status",
          "durationMs",
          "timestamp",
          "binarySha256",
          "platform",
          "toolchain",
          "device",
          "environment",
          "artifacts"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "source",
    "results"
  ]
}
